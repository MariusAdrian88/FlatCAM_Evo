#: appEditors/appGerberEditor.py:8284
msgid "Nearest FOLLOW segment snap"
msgstr "Aggancio al segmento FOLLOW più vicino"

#: appEditors/appGerberEditor.py:8289
msgid ""
"Acquisition radius in pixels. Falls back to global_snap_max model units if "
"canvas conversion is unavailable."
msgstr ""
