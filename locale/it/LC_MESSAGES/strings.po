#: appPlugins/ToolQRCode/QRCodeGen.py:265
#: appPlugins/ToolQRCode/QRCodeGen.py:269
msgid "The QRCode has no geometry."
msgstr "Il QRCode non ha geometria."

#: appPlugins/ToolQRCode/QRCodeGen.py:289
msgid "Wrong rotation or anchor."
msgstr "Rotazione o ancoraggio errati."

#: appPlugins/ToolQRCode/QRCodeUI.py:53
msgid "Gerber Object to which the QRCode will be added."
msgstr "Oggetto Gerber a cui verrà aggiunto il QRCode."

#: appPlugins/ToolQRCode/QRCodeUI.py:72
msgid "The parameters used to shape the QRCode."
msgstr "Parametri usati per formare il QRCode."

#: appPlugins/ToolQRCode/QRCodeUI.py:81
msgid ""
"QRCode version can have values from 1 (21x21 boxes)\n"
"to 40 (177x177 boxes).\n"
"The version is fixed unless Auto is checked: the data must fit in it."
msgstr ""
"La versione del QRCode può avere valori da 1 (moduli 21x21)\n"
"a 40 (moduli 177x177).\n"
"La versione è fissa, a meno che Auto non sia selezionato: i dati devono "
"rientrarvi."

#: appPlugins/ToolQRCode/QRCodeUI.py:88
msgid "Use the smallest version that fits the data."
msgstr "Usa la versione più piccola in grado di contenere i dati."

#: appPlugins/ToolQRCode/QRCodeUI.py:94
msgid "The version, the modules count and the total size of the QRCode."
msgstr "La versione, il numero di moduli e la dimensione totale del QRCode."

#: appPlugins/ToolQRCode/QRCodeUI.py:122
msgid ""
"Box size control the overall size of the QRcode\n"
"by adjusting the size of each box in the code.\n"
"One box size unit is 0.1 mm."
msgstr ""
"La dimensione del modulo controlla la dimensione complessiva del QRCode\n"
"regolando la dimensione di ogni quadratino del codice.\n"
"Un'unità di dimensione del modulo equivale a 0,1 mm."

#: appPlugins/ToolQRCode/QRCodeUI.py:129
msgid "The size of one box in the app units."
msgstr "La dimensione di un quadratino nelle unità dell'app."

#: appPlugins/ToolQRCode/QRCodeUI.py:136
msgid ""
"Size of the QRCode border. How many boxes thick is the border.\n"
"Default value is 4. The width of the clearance around the QRCode.\n"
"A border below 4 boxes breaks the quiet zone of the QR standard."
msgstr ""
"Dimensione del bordo del QRCode: spessore in numero di moduli.\n"
"Il valore predefinito è 4. È la larghezza della zona libera attorno al "
"QRCode.\n"
"Un bordo inferiore a 4 moduli viola la zona libera prevista dallo standard "
"QR."

#: appPlugins/ToolQRCode/QRCodeUI.py:202
msgid "Where the QRCode goes: a click on the canvas or given coordinates."
msgstr "Dove va il QRCode: un clic sul canvas o coordinate indicate."

#: appPlugins/ToolQRCode/QRCodeUI.py:211
msgid ""
"Click: click the destination on the canvas.\n"
"Coordinates: insert at the X, Y given below."
msgstr ""
"Clic: fai clic sulla destinazione nel canvas.\n"
"Coordinate: inserisce alle coordinate X, Y indicate sotto."

#: appPlugins/ToolQRCode/QRCodeUI.py:234
msgid ""
"The point of the QRCode (clearance included)\n"
"that goes to the placement point."
msgstr ""
"Il punto del QRCode (distanza libera inclusa)\n"
"che va nel punto di posizionamento."

#: appPlugins/ToolQRCode/QRCodeUI.py:242
msgid ""
