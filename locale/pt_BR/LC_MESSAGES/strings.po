#: appEditors/appGerberEditor.py:8029
#: appEditors/geo_plugins/GeoSimplificationPlugin.py:255
#: appEditors/grb_plugins/GrbSimplificationPlugin.py:165
msgid "The number of vertex points in the selected geometry element."
msgstr "Número de pontos de vértice no elemento geométrico selecionado."

#: appEditors/appGerberEditor.py:8051
msgid ""
"Numerically move, insert or remove a vertex of one selected region or "
"track.\n"
"A region edits its solid, a track its FOLLOW line. Pads have no vertices."
msgstr ""
"Move, insere ou remove numericamente um vértice de uma região ou trilha "
"selecionada.\n"
"Uma região edita seu sólido, uma trilha sua linha FOLLOW. Pads não têm "
"vértices."

#: appEditors/appGerberEditor.py:8084 appEditors/appGerberEditor.py:8285
msgid "Solid area"
msgstr "Área sólida"

#: appEditors/appGerberEditor.py:8085 appEditors/appGerberEditor.py:8285
msgid "FOLLOW length"
msgstr "Comprimento FOLLOW"

#: appEditors/appGerberEditor.py:8093
#: appEditors/geo_plugins/GeoTransformationPlugin.py:745
#: appEditors/grb_plugins/GrbTransformationPlugin.py:298
msgid "Minimum"
msgstr "Mínimo"

#: appEditors/appGerberEditor.py:8094
msgid "Maximum"
msgstr "Máximo"

#: appEditors/appGerberEditor.py:8095
msgid "Minimum (inclusive)"
msgstr "Mínimo (inclusivo)"

#: appEditors/appGerberEditor.py:8096
msgid "Maximum (inclusive)"
msgstr "Máximo (inclusivo)"

#: appEditors/appGerberEditor.py:8097
msgid ""
"Inclusive range. All enabled filters must match. Missing or empty "
"components don't match."
msgstr ""
"Faixa inclusiva. Todos os filtros ativados devem corresponder. Componentes "
"ausentes ou vazios não correspondem."

#: appEditors/appGerberEditor.py:8109
msgid ""
"Select shapes by their solid bounding-box width and height in current "
"units.\n"
"All enabled dimensions must match within the tolerance (inclusive).\n"
"Searches the selected shapes if any, else all shapes. Replaces the current "
"selection."
msgstr ""
"Seleciona formas pela largura e altura da caixa delimitadora do sólido, em "
"unidades atuais.\n"
"Todas as dimensões ativadas devem corresponder dentro da tolerância "
"(inclusive).\n"
"Pesquisa as formas selecionadas, se houver, senão todas as formas. "
"Substitui a seleção atual."

#: appEditors/appGerberEditor.py:8112
msgid ""
"Solid area and FOLLOW length use inclusive ranges, without dimension "
"tolerance."
msgstr ""
"Área sólida e comprimento FOLLOW usam faixas inclusivas, sem tolerância de "
"dimensão."

#: appEditors/appGerberEditor.py:8114
msgid ""
"Delete matching records from the selected subset, or all records if none "
"are selected. Undo as one operation."
msgstr ""
"Exclui os registros correspondentes do subconjunto selecionado, ou de todos "
"os registros se nenhum for selecionado. Desfazer como uma única operação."

#: appEditors/appGerberEditor.py:8130
msgid "FOLLOW midpoint snap"
msgstr "Encaixe no ponto médio FOLLOW"

#: appEditors/appGerberEditor.py:8131
msgid "Nearest FOLLOW segment snap"
msgstr "Encaixe no segmento FOLLOW mais próximo"

#: appEditors/appGerberEditor.py:8136
msgid ""
"Acquisition radius in pixels. Falls back to global_snap_max model units if "
"canvas conversion is unavailable."
msgstr ""
"Raio de captura em pixels. Usa unidades do modelo global_snap_max se a "
"conversão da tela não estiver disponível."

#: appEditors/appGerberEditor.py:8137
msgid "Snap: None"
msgstr "Encaixe: nenhum"

#: appEditors/appGerberEditor.py:8139
msgid ""
"Nearest target wins. Ties prefer endpoint/bend, midpoint, segment, then "
"grid. Corner snapping uses FOLLOW vertices and flash centers, never solid "
"outlines."
msgstr ""
"O alvo mais próximo vence. Empates favorecem ponto final/curva, ponto "
"médio, segmento e depois grade. O encaixe em cantos usa vértices FOLLOW e "
"centros de flashes, nunca contornos sólidos."

#: appEditors/appGerberEditor.py:8142
msgid "Snap radius"
msgstr "Raio de encaixe"

#: appEditors/appGerberEditor.py:8144
msgid "px"
msgstr "px"

#: appEditors/appGerberEditor.py:8150
msgid "Tracks"
msgstr "Trilhas"

#: appEditors/appGerberEditor.py:8159
msgid "Move Track Bend"
msgstr "Mover curva da trilha"

#: appEditors/appGerberEditor.py:8161
msgid ""
"Drag a FOLLOW bend of a circular-aperture track. Neighboring bends stay "
"fixed.\n"
"Supports one path or a two-record same-aperture join. Arc samples are "
"polyline vertices."
msgstr ""
"Arraste uma curva FOLLOW de uma trilha de abertura circular. As curvas "
"vizinhas permanecem fixas.\n"
"Suporta um caminho ou uma união de dois registros da mesma abertura. "
"Amostras de arco são vértices de polilinha."

#: appEditors/appGerberEditor.py:8167
msgid ""
"Maximum click distance and excluded endpoint distance in current units. "
"Zero requires an exact interior click."
msgstr ""
"Distância máxima do clique e distância excluída do ponto final, em unidades "
"atuais. Zero exige um clique interior exato."

#: appEditors/appGerberEditor.py:8173
msgid "Select one open circular-aperture FOLLOW path, then click its interior."
msgstr ""
"Selecione um caminho FOLLOW aberto de abertura circular e clique no seu "
"interior."

#: appEditors/appGerberEditor.py:8181
msgid ""
"Endpoint ambiguity search radius in current units. Unlike Geometry, Gerber "
"does not bridge gaps or move endpoints."
msgstr ""
"Raio de busca de ambiguidade de ponto final em unidades atuais. Diferente "
"da Geometria, o Gerber não faz pontes sobre lacunas nem move pontos finais."

#: appEditors/appGerberEditor.py:8187
msgid ""
"Join compatible same-aperture circular FOLLOW records. Endpoints must "
"coincide; branches, gaps and material changes are rejected."
msgstr ""
"Une registros FOLLOW circulares compatíveis da mesma abertura. Os pontos "
"finais devem coincidir; ramificações, lacunas e mudanças de material são "
"rejeitadas."

#: appEditors/appGerberEditor.py:8193
#: appGUI/preferences/gerber/GerberEditorPrefGroupUI.py:127
msgid "Regions"
msgstr "Regiões"

#: appEditors/appGerberEditor.py:8203
msgid "Material Union"
msgstr "União de material"

#: appEditors/appGerberEditor.py:8204
msgid "Material Intersection"
msgstr "Interseção de material"

#: appEditors/appGerberEditor.py:8205
msgid "Material Difference"
msgstr "Diferença de material"

#: appEditors/appGerberEditor.py:8206 appGUI/MainGUI.py:922
#: appGUI/MainGUI.py:1522 appGUI/MainGUI.py:2954
msgid "Diff. Keep"
msgstr "Dif. Manter"

#: appEditors/appGerberEditor.py:8207
msgid "Explode Regions"
msgstr "Explodir regiões"

#: appEditors/appGerberEditor.py:8209
msgid ""
"Replace selected polygon material with explicit regions. Holes are "
"retained. Difference subtracts the other selections from the first. Keep "
"Cutters retains them. Clear records are rejected."
msgstr ""
"Substitui o material de polígono selecionado por regiões explícitas. Furos "
"são mantidos. Diferença subtrai as demais seleções da primeira. Manter "
"Cortadores os retém. Registros de polaridade clear são rejeitados."

#: appEditors/appGerberEditor.py:8216
msgid "Rectangle Region"
msgstr "Região retangular"

#: appEditors/appGerberEditor.py:8217
msgid "Text Regions"
msgstr "Regiões de texto"

#: appEditors/appGerberEditor.py:8220
msgid ""
"Draw numeric material as explicit regions, retaining text holes and islands."
msgstr ""
"Desenha material numérico como regiões explícitas, mantendo furos e ilhas "
"de texto."

#: appEditors/appGerberEditor.py:8240
msgid ""
"New diameter of selected plain circular flashes. Tracks and noncircular "
"features are skipped; shared apertures are not resized."
msgstr ""
"Novo diâmetro dos flashes circulares simples selecionados. Trilhas e "
"elementos não circulares são ignorados; aberturas compartilhadas não são "
"redimensionadas."

#: appEditors/appGerberEditor.py:8245
msgid ""
"Resize selected circular flashes about their own centers, as one undo step."
msgstr ""
"Redimensiona os flashes circulares selecionados em torno de seus próprios "
"centros, como uma etapa de desfazer."

