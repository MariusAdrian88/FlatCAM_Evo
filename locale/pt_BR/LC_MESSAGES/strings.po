msgstr "Selecione uma câmera antes de capturar."

#: appPlugins/ToolGcodeSender/Sender.py:2652
#: appPlugins/ToolGcodeSender/SenderRegistrationUI.py:931
msgid "Connect to the controller first."
msgstr "Conecte-se ao controlador primeiro."

#: appPlugins/ToolGcodeSender/Sender.py:2653
