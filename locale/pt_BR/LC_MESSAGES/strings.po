msgid "Unknown laser dithering strategy."
msgstr "Estratégia de pontilhado a laser desconhecida."

#: appPlugins/ToolPhotoCarve/PhotoCarveLaser.py:24
#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:252
msgid ""
"Floyd dithering is limited to 4000000 cells; increase resolution or spacing."
msgstr ""
"O pontilhado Floyd está limitado a 4000000 células; aumente o passo de "
"amostragem ou o espaçamento."

