msgid "Laser power grid does not match the physical image frame."
msgstr ""
"A grade de potência do laser não corresponde ao quadro físico da imagem."

#: appPlugins/ToolPhotoCarve/PhotoCarveLaser.py:100
msgid "Laser paths exceed the point limit; increase resolution or spacing."
msgstr ""
"Os caminhos do laser excedem o limite de pontos; aumente o passo de "
"amostragem ou o espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveLaser.py:111
msgid "Laser power settings must be finite."
msgstr "As configurações de potência do laser devem ser finitas."

#: appPlugins/ToolPhotoCarve/PhotoCarveLaser.py:113
msgid "Laser power must satisfy 0 <= minimum < maximum."
msgstr "A potência do laser deve satisfazer 0 <= mínimo < máximo."

#: appPlugins/ToolPhotoCarve/PhotoCarveLaser.py:115
msgid "Laser path power must be between 0 and 1."
msgstr "A potência do caminho do laser deve estar entre 0 e 1."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:165
msgid "Coordinate decimals must be an integer between 0 and 15."
msgstr ""
"O número de casas decimais das coordenadas deve ser um inteiro entre 0 e 15."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:167
msgid "Bed calibration must contain four finite values."
msgstr "A calibração da mesa deve conter quatro valores finitos."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:170
msgid "Nonzero bed skew requires a positive corresponding bed limit."
msgstr ""
"Uma inclinação diferente de zero da mesa requer um limite correspondente "
"positivo."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:174
msgid "Bed calibration is singular; correct the skew and bed limits."
msgstr ""
"A calibração da mesa é singular; corrija a inclinação e os limites da mesa."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:183
msgid "Bed calibration produces a non-finite coordinate error."
msgstr "A calibração da mesa produz um erro de coordenada não finito."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:200
msgid "%s exceeds the resource limit; increase resolution or spacing."
msgstr ""
"%s excede o limite de recursos; aumente o passo de amostragem ou o "
"espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:207
#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:208
msgid "Tool kernel"
msgstr "Núcleo da ferramenta"

