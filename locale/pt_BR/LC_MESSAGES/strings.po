#: appDatabase.py:1512 appGUI/preferences/tools/ToolsDrillPrefGroupUI.py:212
#: appPlugins/ToolDrilling/DrillingUI.py:436
msgid "Peck drilling"
msgstr "Perfuração com bicadas"

#: appDatabase.py:1514 appGUI/preferences/tools/ToolsDrillPrefGroupUI.py:214
msgid ""
"Drill each hole in steps. After each step the tool goes up to the\n"
"Travel Z (it clears the chips), goes down fast to the Peck Retract\n"
"clearance above the previous depth and feeds on.\n"
"It replaces the Multi-Depth. Ignored by the laser preprocessors."
msgstr ""
"Perfura cada furo em etapas. Após cada etapa a ferramenta sobe até o\n"
"Z de Deslocamento (remove os cavacos), desce rápido até a folga de Recuo da "
"Bicada\n"
"acima da profundidade anterior e avança.\n"
"Substitui a Multi-Profundidade. Ignorado pelos pré-processadores de laser."

#: appDatabase.py:1525
msgid "Peck depth"
msgstr "Profundidade da bicada"

#: appDatabase.py:1526 appGUI/preferences/tools/ToolsDrillPrefGroupUI.py:223
