msgstr "Recuo da bicada"

#: appDatabase.py:1538 appGUI/preferences/tools/ToolsDrillPrefGroupUI.py:230
#: appPlugins/ToolDrilling/DrillingUI.py:457
msgid ""
"Clearance above the previous depth to which the tool goes down fast\n"
"after the full retract, before it feeds on."
msgstr ""
"Folga acima da profundidade anterior até a qual a ferramenta desce rápido\n"
"após o recuo completo, antes de avançar."

