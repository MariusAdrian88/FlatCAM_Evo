msgid "Cannot load image: %s"
msgstr "Não foi possível carregar a imagem: %s"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:483
msgid "Raster paths exceed the point limit; increase spacing or resolution."
msgstr ""
"Os caminhos de varredura excedem o limite de pontos; aumente o espaçamento "
"ou o passo de amostragem."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:499
msgid "Dense spiral exceeds the point limit; increase spacing or resolution."
msgstr ""
"A espiral densa excede o limite de pontos; aumente o espaçamento ou o passo "
"de amostragem."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:534
msgid "Clipped spiral exceeds the point limit; increase spacing or resolution."
msgstr ""
"A espiral recortada excede o limite de pontos; aumente o espaçamento ou o "
"passo de amostragem."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:616
msgid "Tool kernel exceeds the safety limit."
msgstr "O núcleo da ferramenta excede o limite de segurança."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:678
msgid "Relief paths exceed the point limit; increase resolution or spacing."
msgstr ""
"Os caminhos do relevo excedem o limite de pontos; aumente o passo de "
"amostragem ou o espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:687
msgid "Relief certificate does not match the output paths."
msgstr "O certificado do relevo não corresponde aos caminhos de saída."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:694
msgid "Relief path contains invalid coordinates."
msgstr "O caminho do relevo contém coordenadas inválidas."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:697
msgid "Relief plunge does not match its certified center."
msgstr "A descida do relevo não corresponde ao seu centro certificado."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:707
msgid "Relief path left its certified raster line."
msgstr "O caminho do relevo saiu da sua linha de varredura certificada."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:714
msgid "Relief vertices must be exact model raster centers."
msgstr "Os vértices do relevo devem ser centros exatos da varredura do modelo."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:719
msgid "Relief raster indices must be strictly increasing."
msgstr "Os índices de varredura do relevo devem ser estritamente crescentes."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:722
msgid "Relief path coverage differs from its certificate."
msgstr "A cobertura do caminho do relevo difere do seu certificado."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:733
msgid "Relief gouge %.12g at X %.12g Y %.12g."
msgstr "Sobrecorte de %.12g no relevo em X %.12g Y %.12g."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:766
msgid "V-carve paths exceed the point limit; increase resolution or spacing."
msgstr ""
"Os caminhos da gravação em V excedem o limite de pontos; aumente o passo de "
"amostragem ou o espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:797
msgid "Halftone paths exceed the point limit; increase spacing."
msgstr ""
"Os caminhos de meio-tom excedem o limite de pontos; aumente o espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:811
msgid "Roughing exceeds the level limit; increase stepdown."
msgstr ""
"O desbaste excede o limite de níveis; aumente a profundidade por passe."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:835
msgid "Roughing paths exceed the point limit; increase stepdown or spacing."
msgstr ""
"Os caminhos de desbaste excedem o limite de pontos; aumente a profundidade "
"por passe ou o espaçamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:48
msgid "Cannot read the source image of the Photo Carve geometry: %s"
msgstr "Não foi possível ler a imagem de origem da geometria Photo Carve: %s"

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:67
msgid "Unmarked CNC tool simulated as a flat cutter."
msgstr ""
"Ferramenta CNC sem metadados de gravação simulada como fresa de topo plano."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:74
msgid "Invalid simulation cutter."
msgstr "Fresa de simulação inválida."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:98
msgid ""
"The units of the CNCJob and of the photo engraving differ. Make the CNCJob "
"again in the Milling plugin."
msgstr ""
"As unidades do CNCJob e da gravação fotográfica são diferentes. Gere o "
"CNCJob novamente no plugin Fresamento."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:101
msgid ""
"Edited or snippet-bearing CNC programs cannot be associated safely with "
"cutters."
msgstr ""
"Programas CNC editados ou que contêm trechos não podem ser associados com "
"segurança às fresas."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:105
msgid ""
"This CNCJob was converted to other units and is not certified; the "
"simulation shows its converted G-code."
msgstr ""
"Este CNCJob foi convertido para outras unidades e não é certificado; a "
"simulação exibe seu G-code convertido."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:117
msgid "Runnable CNC source differs from tool records; simulation refused."
msgstr ""
"A fonte CNC executável difere dos registros das ferramentas; a simulação "
"foi recusada."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:151
msgid "The CNCJob contains no supported cutting motion."
msgstr "O CNCJob não contém nenhum movimento de corte compatível."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:172
msgid "Pass power/depth semantics do not match the job mode."
msgstr ""
"A semântica de potência/profundidade das passadas não corresponde ao modo "
"do trabalho."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:181
msgid "Invalid photo engraving path."
msgstr "Caminho de gravação fotográfica inválido."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:204
msgid "The image produced no engraving paths."
msgstr "A imagem não produziu caminhos de gravação."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:217
msgid ""
"The tools differ from the tools of the photo engraving. Open the Photo "
"Carve plugin and click \"Generate Geometry\" to make the geometry again; "
"then make the CNCJob from the new geometry."
msgstr ""
"As ferramentas diferem das usadas na gravação fotográfica. Abra o plugin "
"Photo Carve e clique em \"Gerar Geometria\" para gerar a geometria "
"novamente; depois crie o CNCJob a partir da nova geometria."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:225
msgid ""
"The shape of the cutter changed. Open the Photo Carve plugin and click "
"\"Generate Geometry\" to make the geometry again; then make the CNCJob from "
"the new geometry."
msgstr ""
"O formato da fresa mudou. Abra o plugin Photo Carve e clique em \"Gerar "
"Geometria\" para gerar a geometria novamente; depois crie o CNCJob a partir "
"da nova geometria."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:238
msgid ""
"The dimensions of the cutter changed. Open the Photo Carve plugin and click "
"\"Generate Geometry\" to make the geometry again; then make the CNCJob from "
"the new geometry."
msgstr ""
"As dimensões da fresa mudaram. Abra o plugin Photo Carve e clique em "
"\"Gerar Geometria\" para gerar a geometria novamente; depois crie o CNCJob "
"a partir da nova geometria."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:25
msgid ""
"Simulation stock exceeds the cell limit; increase simulation resolution."
msgstr ""
"O material bruto da simulação excede o limite de células; aumente o passo "
"de amostragem da simulação."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:50
msgid "Simulation path must contain finite XYZ points."
msgstr "O caminho da simulação deve conter pontos XYZ finitos."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:60
msgid "Simulation sampling exceeds the point limit."
msgstr "A amostragem da simulação excede o limite de pontos."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:67
msgid "Simulation subcell sampling must be a positive integer."
msgstr "A amostragem de subcélulas da simulação deve ser um inteiro positivo."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:96
msgid "Simulation cutter kernel exceeds the safety limit."
msgstr "O núcleo da fresa de simulação excede o limite de segurança."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:125
msgid "Independent gouge reference is limited to 200 by 200 cells."
msgstr ""
"A referência independente de sobrecorte está limitada a 200 por 200 células."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:167
msgid "Maximum laser power must be finite and positive."
msgstr "A potência máxima do laser deve ser finita e positiva."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:169
msgid "Laser simulation exceeds the cell limit."
msgstr "A simulação do laser excede o limite de células."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:182
msgid "Laser simulation sampling exceeds the point limit."
msgstr "A amostragem da simulação do laser excede o limite de pontos."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:201
msgid "Known units and a positive arc resolution are required."
msgstr "São necessárias unidades conhecidas e uma resolução de arco positiva."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:213
msgid "Duplicate arc geometry word: %s."
msgstr "Palavra de geometria de arco duplicada: %s."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:218
msgid "Conflicting motion commands."
msgstr "Comandos de movimento conflitantes."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:232
msgid "%d arc(s) could not be resolved; simulation refused."
msgstr "%d arco(s) não puderam ser resolvidos; simulação recusada."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:242
msgid "Simulation units must be MM or IN."
msgstr "As unidades da simulação devem ser MM ou IN."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:260
msgid "Unsupported G-code syntax on line %d."
msgstr "Sintaxe G-code não compatível na linha %d."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:265
msgid "Non-finite G-code value on line %d."
msgstr "Valor G-code não finito na linha %d."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:269
msgid "Unsupported %s%s on line %d; split arcs and use absolute linear motion."
msgstr ""
"%s%s não compatível na linha %d; divida os arcos e use movimento linear "
"absoluto."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:275
msgid "Unsupported or duplicate %s word on line %d."
msgstr "Palavra %s não compatível ou duplicada na linha %d."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:278
msgid "Conflicting modal commands on line %d."
msgstr "Comandos modais conflitantes na linha %d."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:281
msgid "Program end with motion axes is not supported."
msgstr "O fim do programa com eixos de movimento não é compatível."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:284
msgid "G54 is only supported before the first motion."
msgstr "G54 só é compatível antes do primeiro movimento."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:298
msgid "Laser/spindle power must not be negative."
msgstr "A potência do laser/spindle não pode ser negativa."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:302
msgid "Dwell does not accept motion axes."
msgstr "A pausa temporizada (dwell) não aceita eixos de movimento."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:305
msgid "P words are only supported for dwell."
msgstr "Palavras P só são aceitas na pausa temporizada (dwell)."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:313
msgid "Motion axes require a known G0/G1 mode."
msgstr "Os eixos de movimento requerem um modo G0/G1 conhecido."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:316
msgid "Cutting motion requires known starting and ending XY positions."
msgstr "O movimento de corte requer posições XY inicial e final conhecidas."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:318
msgid "Milling motion requires a known Z position."
msgstr "O movimento de fresamento requer uma posição Z conhecida."

