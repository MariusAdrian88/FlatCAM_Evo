"shapes."
msgstr ""
"Editarea vârfurilor acceptă LineString, LinearRing, Polygon și formele lor "
"multiparte."

#: appEditors/vertex_ops.py:282 appEditors/vertex_ops.py:292
msgid "Choose a valid vertex index."
msgstr "Alegeți un index de vârf valid."

#: appEditors/vertex_ops.py:286
