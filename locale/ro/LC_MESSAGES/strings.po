#: appEditors/grb_plugins/GrbFollowPlugin.py:114
msgid "The selected path or editing session changed. Reopen Split path."
msgstr ""
"Traseul selectat sau sesiunea de editare s-au modificat. Redeschideți "
"Divizare traseu."

#: appEditors/appGeoEditor.py:1135
msgid ""
"Split supports one two-dimensional open LineString only.\n"
"Rings, polygons and multipart shapes are not supported."
msgstr ""
"Divizarea acceptă doar un LineString deschis bidimensional.\n"
"Inelele, poligoanele și formele multiparte nu sunt acceptate."

#: appEditors/appGeoEditor.py:1139
msgid ""
"Split tolerance must be a finite, nonnegative distance in current units."
msgstr ""
"Toleranța de divizare trebuie să fie o distanță finită, nenegativă, în "
"unitățile curente."

#: appEditors/appGeoEditor.py:1141 appEditors/appGeoEditor.py:1144
msgid "Choose a finite X and Y split point."
msgstr "Alegeți un punct de divizare cu X și Y finite."

#: appEditors/appGeoEditor.py:1147
msgid "The split point is outside the path tolerance."
msgstr "Punctul de divizare este în afara toleranței traseului."

#: appEditors/appGeoEditor.py:1150
msgid ""
"Choose a split point farther than the tolerance from both path endpoints."
msgstr ""
"Alegeți un punct de divizare mai departe de toleranță față de ambele capete "
"ale traseului."

#: appEditors/appGeoEditor.py:1153
msgid "The split must produce two nonzero-length paths."
msgstr "Divizarea trebuie să producă două trasee de lungime nenulă."

#: appEditors/appGeoEditor.py:1178
msgid "Join tolerance must be a finite, nonnegative distance in current units."
msgstr ""
"Toleranța de unire trebuie să fie o distanță finită, nenegativă, în "
"unitățile curente."

#: appEditors/appGeoEditor.py:1181
msgid "Select at least two distinct open LineStrings to join."
msgstr "Selectați cel puțin două LineString deschise distincte pentru unire."

#: appEditors/appGeoEditor.py:1186
msgid "The selected paths changed. Select stored paths again."
msgstr "Traseele selectate s-au modificat. Selectați din nou traseele salvate."

#: appEditors/appGeoEditor.py:1192
msgid "Join supports two-dimensional, simple open LineStrings only."
msgstr "Unirea acceptă doar LineString deschise, simple, bidimensionale."

#: appEditors/appGeoEditor.py:1204
#: appEditors/grb_plugins/GrbFollowPlugin.py:198
msgid "Ambiguous or branching endpoints. Reduce tolerance or selection."
msgstr "Capete ambigue sau ramificate. Reduceți toleranța sau selecția."

#: appEditors/appGeoEditor.py:1211
msgid "No selected endpoints are within the join tolerance."
msgstr "Niciun capăt selectat nu se află în toleranța de unire."

#: appEditors/appGeoEditor.py:1234
msgid "Joined paths must have compatible metadata and tool ownership."
msgstr ""
"Traseele unite trebuie să aibă metadate și apartenență la unealtă "
"compatibile."

#: appEditors/appGeoEditor.py:1247
msgid "Join would create branching, overlapping or invalid geometry."
msgstr "Unirea ar crea o geometrie ramificată, suprapusă sau invalidă."

#: appEditors/appGeoEditor.py:1256
msgid "Joined components would intersect or branch. Refine the selection."
msgstr "Componentele unite ar intersecta sau s-ar ramifica. Rafinați selecția."

#: appEditors/appGeoEditor.py:1265
msgid ""
"Join complete: %d separate components; straight bridges added %s %s of "
"length."
msgstr ""
"Unire finalizată: %d componente separate; punțile drepte au adăugat %s %s "
