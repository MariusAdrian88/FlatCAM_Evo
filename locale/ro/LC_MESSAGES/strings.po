msgstr "Lucrarea necesită până la %d puncte; limita este %d. Măriți spațierea sau pasul de eșantionare."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:269
msgid "Roughing levels"
msgstr "Niveluri de degroșare"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:271
msgid "Roughing needs %d levels; limit is %d. Use stepdown at least %.12g."
msgstr "Degroșarea necesită %d niveluri; limita este %d. Folosiți un pas pe adâncime de cel puțin %.12g."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:276
msgid ""
"Roughing needs up to %d points; limit is %d. Increase stepdown or spacing."
msgstr ""
"Degroșarea necesită până la %d puncte; limita este %d. Măriți pasul pe "
"adâncime sau spațierea."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:279
msgid ""
"Combined passes need up to %d points; limit is %d. Increase spacing, "
"resolution or stepdown."
msgstr ""
"Trecerile combinate necesită până la %d puncte; limita este %d. Măriți "
"spațierea, pasul de eșantionare sau pasul pe adâncime."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:294
msgid "%s must be a finite number."
msgstr "%s trebuie să fie un număr finit."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:296
msgid "Laser levels must be an integer of at least 2."
msgstr "Numărul de niveluri ale laserului trebuie să fie un întreg de cel puțin 2."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:298
msgid "Simulation material must be one of: %s."
msgstr "Materialul simulării trebuie să fie unul dintre: %s."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:301
msgid "%s must be positive."
msgstr "%s trebuie să fie pozitiv."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:304
msgid "%s must not be negative."
msgstr "%s nu trebuie să fie negativ."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:308
msgid "Select a valid strategy for the engraving mode."
msgstr "Selectați o strategie validă pentru modul de gravare."

