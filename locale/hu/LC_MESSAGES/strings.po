msgstr "A transzformáció érvénytelen geometriát eredményezett."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:59
msgid "Transformation collapsed the geometry."
msgstr "A transzformáció összeomlasztotta a geometriát."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:145
msgid "Transform values and reference must be finite and nonsingular."
msgstr ""
"A transzformációs értékeknek és a referenciának végesnek és nem "
"szingulárisnak kell lenniük."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:165
msgid "Buffer value must be finite."
msgstr "A buffer értékének végesnek kell lennie."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:169
msgid "Buffer factor must be greater than -100%."
msgstr "A buffer tényezőnek -100%-nál nagyobbnak kell lennie."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:189
msgid "Transform matrix must be finite and nonsingular."
msgstr ""
"A transzformációs mátrixnak végesnek és nem szingulárisnak kell lennie."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:192
msgid "Flip"
msgstr "Tükrözés"

