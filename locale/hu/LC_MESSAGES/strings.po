msgstr ""
"A kivonandónak nincs területe (a vonalakból álló Geometria esetén nullánál "
"nagyobb Margó szükséges). Nem jött létre semmi."

#: appPlugins/ToolSub/Sub.py:539
msgid "The target object does not exist anymore."
msgstr "A célobjektum már nem létezik."

#: appPlugins/ToolSub/Sub.py:572
msgid "Kept"
msgstr "Megtartva"

#: appPlugins/ToolSub/Sub.py:572
