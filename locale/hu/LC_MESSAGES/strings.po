msgstr "Spirál mintapontok"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:244
msgid "Dense spiral samples"
msgstr "Sűrű spirál mintapontok"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:247
msgid "Dot rows"
msgstr "Pontsorok"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:248
msgid "Dot columns"
msgstr "Pontoszlopok"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:262
msgid "Job needs up to %d points; limit is %d. Increase spacing or resolution."
msgstr ""
"A feladat akár %d pontot is igényelhet; a korlát %d. A térköz vagy a "
"felbontás növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:269
msgid "Roughing levels"
msgstr "Nagyolási szintek"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:271
msgid "Roughing needs %d levels; limit is %d. Use stepdown at least %.12g."
msgstr ""
"A nagyolás %d szintet igényel; a korlát %d. Legalább %.12g fogásmélység "
"alkalmazása szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:276
msgid ""
"Roughing needs up to %d points; limit is %d. Increase stepdown or spacing."
msgstr ""
"A nagyolás akár %d pontot is igényelhet; a korlát %d. A fogásmélység vagy a "
"térköz növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:279
msgid ""
"Combined passes need up to %d points; limit is %d. Increase spacing, "
"resolution or stepdown."
msgstr ""
"Az egyesített fogások akár %d pontot is igényelhetnek; a korlát %d. A "
"térköz, a felbontás vagy a fogásmélység növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:294
msgid "%s must be a finite number."
msgstr "A(z) %s értékének véges számnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:296
msgid "Laser levels must be an integer of at least 2."
msgstr "A lézerszintek számának legalább 2 értékű egész számnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:298
msgid "Simulation material must be one of: %s."
msgstr "A szimulációs anyagnak a következők egyikének kell lennie: %s."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:301
msgid "%s must be positive."
msgstr "A(z) %s értékének pozitívnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:304
msgid "%s must not be negative."
msgstr "A(z) %s értéke nem lehet negatív."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:308
msgid "Select a valid strategy for the engraving mode."
msgstr "Érvényes stratégia kiválasztása szükséges a gravírozási módhoz."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:312
msgid "Select a valid tone mapping for the engraving mode."
msgstr "Érvényes tónusleképezés kiválasztása szükséges a gravírozási módhoz."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:315
msgid "Tool kind must be vbit, ball or flat."
msgstr "Az eszköztípusnak vbit, ball vagy flat értékűnek kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:317
msgid "V-carving and halftone dots require a V-bit."
msgstr "A V-gravírozáshoz és a félárnyalatos pontokhoz V-maró szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:323
msgid "Roughing is used only for Relief and Lithophane; it was ignored."
msgstr ""
"A nagyolás csak dombormű és litofán esetén használatos; figyelmen kívül "
"hagyva."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:327
msgid ""
"Tool diameter must be positive and tip diameter must be smaller and "
"nonnegative."
msgstr ""
"Az eszközátmérőnek pozitívnak, a csúcsátmérőnek pedig ennél kisebbnek és "
"nem negatívnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:329
msgid "V-bit angle must be between 0 and 180 degrees."
msgstr "A V-maró szögének 0 és 180 fok között kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:332
msgid ""
"Lithophane needs 0 < minimum < maximum thickness and a nonnegative frame."
msgstr ""
"A litofánhoz 0 < minimum < maximum vastagság és nem negatív keret szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:335
msgid "Depths must satisfy 0 <= minimum <= maximum, with maximum positive."
msgstr ""
"A mélységeknek teljesíteniük kell a 0 <= minimum <= maximum feltételt, "
"pozitív maximummal."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:339
msgid "Minimum depth exceeds the V-bit width limit %.12g."
msgstr "A minimális mélység túllépi a V-maró szélességi korlátját (%.12g)."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:342
msgid "Maximum depth clamped to the V-bit width limit %.12g."
msgstr "A maximális mélység a V-maró szélességi korlátjára (%.12g) korlátozva."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:344
msgid "Roughing needs positive stepdown and a nonnegative allowance."
msgstr "A nagyoláshoz pozitív fogásmélység és nem negatív ráhagyás szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:347
msgid "Image dimensions must be positive integers."
msgstr "A kép méreteinek pozitív egész számoknak kell lenniük."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:349
msgid "Physical image height must be finite and positive."
msgstr "A kép fizikai magasságának végesnek és pozitívnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:352
msgid "Coordinate quantum exceeds tolerance; increase coordinate decimals."
msgstr ""
"A koordináta-lépésköz meghaladja a tűréshatárt; a koordináta-tizedesjegyek "
"számának növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:355
msgid "Image grid"
msgstr "Képrács"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:358
msgid ""
"Image grid has %d cells; limit is %d. Increase resolution or laser spacing."
msgstr ""
"A képrács %d cellát tartalmaz; a korlát %d. A felbontás vagy a "
"lézertávolság növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:361
#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:362
msgid "Simulation grid"
msgstr "Szimulációs rács"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:364
msgid ""
"Simulation grid has %d cells; limit is %d. Increase simulation resolution."
msgstr ""
"A szimulációs rács %d cellát tartalmaz; a korlát %d. A szimulációs "
"felbontás növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:380
msgid "Cannot load image: %s"
msgstr "A kép nem tölthető be: %s"

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:483
msgid "Raster paths exceed the point limit; increase spacing or resolution."
msgstr ""
"A raszterpályák túllépik a pontkorlátot; a távolság vagy a felbontás "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:499
msgid "Dense spiral exceeds the point limit; increase spacing or resolution."
msgstr ""
"A sűrű spirál túllépi a pontkorlátot; a távolság vagy a felbontás növelése "
"szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:534
msgid "Clipped spiral exceeds the point limit; increase spacing or resolution."
msgstr ""
"A vágott spirál túllépi a pontkorlátot; a távolság vagy a felbontás "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:616
msgid "Tool kernel exceeds the safety limit."
msgstr "Az eszközkernel túllépi a biztonsági korlátot."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:678
msgid "Relief paths exceed the point limit; increase resolution or spacing."
msgstr ""
"A domborműpályák túllépik a pontkorlátot; a felbontás vagy a távolság "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:687
msgid "Relief certificate does not match the output paths."
msgstr "A dombormű-tanúsítvány nem egyezik a kimeneti pályákkal."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:694
msgid "Relief path contains invalid coordinates."
msgstr "A domborműpálya érvénytelen koordinátákat tartalmaz."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:697
msgid "Relief plunge does not match its certified center."
msgstr "A dombormű bemerülési pontja nem egyezik a tanúsított középpontjával."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:707
msgid "Relief path left its certified raster line."
msgstr "A domborműpálya elhagyta a tanúsított rasztervonalát."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:714
msgid "Relief vertices must be exact model raster centers."
msgstr ""
"A dombormű csúcspontjainak pontos modell-raszterközéppontoknak kell lenniük."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:719
msgid "Relief raster indices must be strictly increasing."
msgstr "A dombormű raszterindexeinek szigorúan növekvőnek kell lenniük."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:722
msgid "Relief path coverage differs from its certificate."
msgstr "A domborműpálya lefedettsége eltér a tanúsítványától."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:733
msgid "Relief gouge %.12g at X %.12g Y %.12g."
msgstr "Dombormű-túlmarás (%.12g) az X %.12g Y %.12g pontban."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:766
msgid "V-carve paths exceed the point limit; increase resolution or spacing."
msgstr ""
"A V-gravírozási pályák túllépik a pontkorlátot; a felbontás vagy a távolság "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:797
msgid "Halftone paths exceed the point limit; increase spacing."
msgstr ""
"A féltónuspályák túllépik a pontkorlátot; a távolság növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:811
msgid "Roughing exceeds the level limit; increase stepdown."
msgstr "A nagyolás túllépi a szintkorlátot; a fogásmélység növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveModel.py:835
msgid "Roughing paths exceed the point limit; increase stepdown or spacing."
msgstr ""
"A nagyolási pályák túllépik a pontkorlátot; a fogásmélység vagy a távolság "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:48
msgid "Cannot read the source image of the Photo Carve geometry: %s"
msgstr "A fotógravírozási geometria forrásképe nem olvasható: %s"

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:67
msgid "Unmarked CNC tool simulated as a flat cutter."
msgstr "Jelöletlen CNC-eszköz síkmaróként szimulálva."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:74
msgid "Invalid simulation cutter."
msgstr "Érvénytelen szimulációs maró."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:98
msgid ""
"The units of the CNCJob and of the photo engraving differ. Make the CNCJob "
"again in the Milling plugin."
msgstr ""
"A CNC Munka és a fotógravírozás mértékegységei eltérnek. A CNC Munka "
"objektumot újra létre kell hozni a Marás bővítményben."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:101
msgid ""
"Edited or snippet-bearing CNC programs cannot be associated safely with "
"cutters."
msgstr ""
"A szerkesztett vagy kódrészletet tartalmazó CNC-programok nem rendelhetők "
"biztonságosan marókhoz."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:105
msgid ""
"This CNCJob was converted to other units and is not certified; the "
"simulation shows its converted G-code."
msgstr ""
"Ez a CNC Munka más mértékegységekre lett átváltva és nem tanúsított; a "
"szimuláció az átváltott GCode kódot jeleníti meg."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:117
msgid "Runnable CNC source differs from tool records; simulation refused."
msgstr ""
"A futtatható CNC-forrás eltér az eszközadatoktól; a szimuláció elutasítva."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:151
msgid "The CNCJob contains no supported cutting motion."
msgstr "A CNC Munka nem tartalmaz támogatott vágási mozgást."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:172
msgid "Pass power/depth semantics do not match the job mode."
msgstr ""
"A fogások teljesítmény-/mélységszemantikája nem egyezik a feladat módjával."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:181
msgid "Invalid photo engraving path."
msgstr "Érvénytelen fotógravírozási pálya."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:203
msgid "The image produced no engraving paths."
msgstr "A kép nem eredményezett gravírozási pályákat."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:216
msgid ""
"The tools differ from the tools of the photo engraving. Open the Photo "
"Carve plugin and click \"Generate Geometry\" to make the geometry again; "
"then make the CNCJob from the new geometry."
msgstr ""
"Az eszközök eltérnek a fotógravírozás eszközeitől. A Fotógravírozás "
"bővítmény megnyitása után a „Geometria létrehozása” gombra kattintva a "
"geometriát újra létre kell hozni, majd az új geometriából el kell készíteni "
"a CNC Munka objektumot."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:224
msgid ""
"The shape of the cutter changed. Open the Photo Carve plugin and click "
"\"Generate Geometry\" to make the geometry again; then make the CNCJob from "
"the new geometry."
msgstr ""
"A maró alakja megváltozott. A Fotógravírozás bővítmény megnyitása után a "
"„Geometria létrehozása” gombra kattintva a geometriát újra létre kell "
"hozni, majd az új geometriából el kell készíteni a CNC Munka objektumot."

#: appPlugins/ToolPhotoCarve/PhotoCarveObject.py:237
msgid ""
"The dimensions of the cutter changed. Open the Photo Carve plugin and click "
"\"Generate Geometry\" to make the geometry again; then make the CNCJob from "
"the new geometry."
msgstr ""
"A maró méretei megváltoztak. A Fotógravírozás bővítmény megnyitása után a "
"„Geometria létrehozása” gombra kattintva a geometriát újra létre kell "
"hozni, majd az új geometriából el kell készíteni a CNC Munka objektumot."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:25
msgid ""
"Simulation stock exceeds the cell limit; increase simulation resolution."
msgstr ""
"A szimulációs nyersdarab túllépi a cellakorlátot; a szimulációs felbontás "
"növelése szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:50
msgid "Simulation path must contain finite XYZ points."
msgstr "A szimulációs pályának véges XYZ-pontokat kell tartalmaznia."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:60
msgid "Simulation sampling exceeds the point limit."
msgstr "A szimulációs mintavételezés túllépi a pontkorlátot."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:67
msgid "Simulation subcell sampling must be a positive integer."
msgstr ""
"A szimulációs alcellás mintavételezésnek pozitív egész számnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:96
msgid "Simulation cutter kernel exceeds the safety limit."
msgstr "A szimulációs marókernel túllépi a biztonsági korlátot."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:125
msgid "Independent gouge reference is limited to 200 by 200 cells."
msgstr ""
"A független túlmarás-referencia legfeljebb 200 × 200 cellára korlátozódik."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:167
msgid "Maximum laser power must be finite and positive."
msgstr "A maximális lézerteljesítménynek végesnek és pozitívnak kell lennie."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:169
msgid "Laser simulation exceeds the cell limit."
msgstr "A lézerszimuláció túllépi a cellakorlátot."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:182
msgid "Laser simulation sampling exceeds the point limit."
msgstr "A lézerszimuláció mintavételezése túllépi a pontkorlátot."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:201
msgid "Known units and a positive arc resolution are required."
msgstr "Ismert mértékegységek és pozitív ívfelbontás szükségesek."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:213
msgid "Duplicate arc geometry word: %s."
msgstr "Duplikált ívgeometriai szó: %s."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:218
msgid "Conflicting motion commands."
msgstr "Ellentmondó mozgásparancsok."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:232
msgid "%d arc(s) could not be resolved; simulation refused."
msgstr "%d ív nem volt felbontható; a szimuláció elutasítva."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:242
msgid "Simulation units must be MM or IN."
msgstr "A szimulációs mértékegységeknek MM vagy IN értékűnek kell lenniük."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:260
msgid "Unsupported G-code syntax on line %d."
msgstr "Nem támogatott GCode szintaxis a(z) %d. sorban."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:265
msgid "Non-finite G-code value on line %d."
msgstr "Nem véges GCode érték a(z) %d. sorban."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:269
msgid "Unsupported %s%s on line %d; split arcs and use absolute linear motion."
msgstr ""
"Nem támogatott %s%s a(z) %d. sorban; az íveket fel kell bontani, és "
"abszolút lineáris mozgást kell használni."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:275
msgid "Unsupported or duplicate %s word on line %d."
msgstr "Nem támogatott vagy duplikált %s szó a(z) %d. sorban."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:278
msgid "Conflicting modal commands on line %d."
msgstr "Ellentmondó modális parancsok a(z) %d. sorban."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:281
msgid "Program end with motion axes is not supported."
msgstr "A mozgástengelyekkel együtt megadott programvég nem támogatott."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:284
msgid "G54 is only supported before the first motion."
msgstr "A G54 csak az első mozgás előtt támogatott."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:298
msgid "Laser/spindle power must not be negative."
msgstr "A lézer-/főorsó-teljesítmény nem lehet negatív."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:302
msgid "Dwell does not accept motion axes."
msgstr "A késleltetés nem fogad el mozgástengelyeket."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:305
msgid "P words are only supported for dwell."
msgstr "A P szavak csak késleltetéshez támogatottak."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:313
msgid "Motion axes require a known G0/G1 mode."
msgstr "A mozgástengelyekhez ismert G0/G1 mód szükséges."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:316
msgid "Cutting motion requires known starting and ending XY positions."
msgstr "A vágási mozgáshoz ismert kezdő és vég XY-pozíciók szükségesek."

#: appPlugins/ToolPhotoCarve/PhotoCarveSim.py:318
msgid "Milling motion requires a known Z position."
msgstr "A marási mozgáshoz ismert Z-pozíció szükséges."

