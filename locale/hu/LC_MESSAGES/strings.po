msgid "Starting G-Code for tool with diameter"
msgstr "GCode indítása a következő átmérőjű eszközhöz"

#: camlib.py:4422 camlib.py:5468 camlib.py:5551 camlib.py:6669 camlib.py:6955
#: camlib.py:7112
msgid "G91 coordinates not implemented"
msgstr "A G91 koordináták nincsenek megvalósítva"

