#: appEditors/appGeoEditor.py:4349
#: appGUI/preferences/tools/ToolsFollowPrefGroupUI.py:26
msgid "Paths"
msgstr "Útvonalak"

#: appEditors/appGeoEditor.py:4349
msgid "Split and join open paths."
msgstr "Nyitott útvonalak felosztása és összekapcsolása."

#: appEditors/appGeoEditor.py:4351 appEditors/appGerberEditor.py:8845
msgid "Split path"
msgstr "Útvonal felosztása"

#: appEditors/appGeoEditor.py:4352
msgid "Select one open LineString, then click its interior to split it."
msgstr ""
"Egy nyitott LineString kijelölése, majd a belső részére kattintva "
"felosztható."

#: appEditors/appGeoEditor.py:4359
msgid ""
"Maximum click distance from the path, and excluded distance along the path "
"from each endpoint.\n"
"In current units, independent of grid and pixel snap radius. Zero requires "
"an exact interior click."
msgstr ""
"Maximális kattintási távolság az útvonaltól, valamint a végpontoktól az "
"útvonal mentén kizárt távolság.\n"
"Az aktuális mértékegységekben, a rácstól és a pixel alapú tapadási sugártól "
"függetlenül. Nulla esetén pontos belső kattintás szükséges."

#: appEditors/appGeoEditor.py:4361 appEditors/appGerberEditor.py:8841
msgid "Split tolerance"
msgstr "Felosztási tolerancia"

#: appEditors/appGeoEditor.py:4366 appEditors/appGerberEditor.py:8859
msgid "Join paths"
msgstr "Útvonalak összekapcsolása"

#: appEditors/appGeoEditor.py:4367
msgid "Join selected open LineStrings. Ambiguous branches are rejected."
msgstr ""
"Kijelölt nyitott LineString elemek összekapcsolása. A többértelmű "
"elágazásokat elutasítja."

#: appEditors/appGeoEditor.py:4371
msgid ""
"Maximum endpoint gap in current units. Zero joins exact endpoints only.\n"
"Near endpoints get a straight bridge: no vertices move; length increases by "
"the gap.\n"
"Each endpoint must have only one candidate. Disjoint components stay "
"separate."
msgstr ""
"Maximális végpontköz az aktuális mértékegységekben. Nulla esetén csak a "
"pontosan egybeeső végpontok kapcsolódnak össze.\n"
"A közeli végpontok egyenes összekötést kapnak: a csúcspontok nem mozdulnak "
"el, a hossz a hézaggal nő.\n"
"Minden végpontnak legfeljebb egy jelöltje lehet. A különálló komponensek "
"külön maradnak."

#: appEditors/appGeoEditor.py:4374 appEditors/appGerberEditor.py:8855
msgid "Join tolerance"
msgstr "Összekapcsolási tolerancia"

#: appEditors/appGeoEditor.py:4380
msgid "Read-only diagnostics of the selected geometry."
msgstr "A kijelölt geometria csak olvasható diagnosztikája."

#: appEditors/appGeoEditor.py:4382 appEditors/appGerberEditor.py:8938
msgid "Inspect selected geometry"
msgstr "Kijelölt geometria vizsgálata"

#: appEditors/appGeoEditor.py:4383
msgid ""
"Read-only snapshot. Open paths are informational; no repair is performed."
msgstr ""
"Csak olvasható pillanatkép. A nyitott útvonalak tájékoztató jellegűek; "
"javítás nem történik."

#: appEditors/appGeoEditor.py:4387
msgid ""
"Near endpoint distance in current units, independent of grid and snapping.\n"
"Zero reports exactly coincident endpoints only. Paths remain open and "
"unchanged."
msgstr ""
"Közeli végpontok távolsága az aktuális mértékegységekben, a rácstól és a "
"tapadástól függetlenül.\n"
"Nulla esetén csak a pontosan egybeeső végpontokat jelzi. Az útvonalak "
"nyitottak és változatlanok maradnak."

#: appEditors/appGeoEditor.py:4389 appEditors/appGerberEditor.py:8948
msgid "Endpoint tolerance"
msgstr "Végpont-tolerancia"

#: appEditors/appGeoEditor.py:4402 appEditors/appGerberEditor.py:8731
msgid "Select by Size"
msgstr "Kijelölés méret alapján"

#: appEditors/appGeoEditor.py:4403
msgid "Select or delete shapes by area or length."
msgstr "Alakzatok kijelölése vagy törlése terület vagy hossz alapján."

#: appEditors/appGeoEditor.py:4404
msgid "Filter polygons by area"
msgstr "Poligonok szűrése terület alapján"

#: appEditors/appGeoEditor.py:4406
msgid ""
"Applies to Polygon and MultiPolygon shapes (text counts as polygons), area "
"in current units squared.\n"
"Limits are inclusive. Points and mixed collections never match."
msgstr ""
"Poligon és MultiPolygon alakzatokra vonatkozik (a szöveg poligonnak "
"számít), a terület az aktuális mértékegység négyzetében értendő.\n"
"A határértékek bezárólagosak. Pontok és vegyes gyűjtemények soha nem "
"egyeznek."

#: appEditors/appGeoEditor.py:4413
msgid "Min area"
msgstr "Min. terület"

#: appEditors/appGeoEditor.py:4416
msgid "Max area"
msgstr "Max. terület"

#: appEditors/appGeoEditor.py:4420
msgid "Filter paths by length"
msgstr "Útvonalak szűrése hossz alapján"

#: appEditors/appGeoEditor.py:4422
msgid ""
"Applies to LineString, LinearRing and MultiLineString shapes, length in "
"current units.\n"
"Limits are inclusive. Points and mixed collections never match."
msgstr ""
"LineString, LinearRing és MultiLineString alakzatokra vonatkozik, a hossz "
"az aktuális mértékegységekben értendő.\n"
"A határértékek bezárólagosak. Pontok és vegyes gyűjtemények soha nem "
"egyeznek."

#: appEditors/appGeoEditor.py:4429
msgid "Min length"
msgstr "Min. hossz"

#: appEditors/appGeoEditor.py:4432
msgid "Max length"
msgstr "Max. hossz"

#: appEditors/appGeoEditor.py:4436 appEditors/appGerberEditor.py:8780
#: appGUI/MainGUI.py:974 appGUI/MainGUI.py:1447 appGUI/MainGUI.py:1473
#: appGUI/MainGUI.py:1549 appGUI/MainGUI.py:2724 appGUI/MainGUI.py:2750
#: appGUI/MainGUI.py:2816
msgid "Select"
msgstr "Kijelölés"

#: appEditors/appGeoEditor.py:4438
msgid ""
"Select the shapes matching the enabled filters. Searches the selected "
"shapes if any,\n"
"else all the shapes. Replaces the current selection."
msgstr ""
"Az engedélyezett szűrőknek megfelelő alakzatok kijelölése. Ha vannak "
"kijelölt alakzatok, azok között keres,\n"
"egyébként az összes alakzat között. Felülírja az aktuális kijelölést."

#: appEditors/appGeoEditor.py:4442
msgid ""
"Delete the shapes matching the enabled filters, as one Undo/Redo step.\n"
"Searches the selected shapes if any, else all the shapes."
msgstr ""
"Az engedélyezett szűrőknek megfelelő alakzatok törlése egyetlen "
"Visszavonás/Ismétlés lépésként.\n"
"Ha vannak kijelölt alakzatok, azok között keres, egyébként az összes "
"alakzat között."

#: appEditors/appGeoEditor.py:4451 appEditors/appGerberEditor.py:8900
msgid "Resize Circles"
msgstr "Körök átméretezése"

#: appEditors/appGeoEditor.py:4452
msgid "Resize the selected circles to a new diameter."
msgstr "A kijelölt körök átméretezése új átmérőre."

#: appEditors/appGeoEditor.py:4458
msgid ""
"Diameter to resize the selected circles to. Each circle keeps its own "
"center.\n"
"Circles are recognized by their shape (polygon or outline with at least 8 "
"vertices,\n"
"all at the same distance from the center). Other shapes are skipped."
msgstr ""
"Az új átmérő, amelyre a kijelölt körök átméreteződnek. Minden kör megtartja "
"a saját középpontját.\n"
"A körök az alakjuk alapján kerülnek felismerésre (legalább 8 csúcsponttal "
"rendelkező poligon vagy körvonal,\n"
"ahol minden csúcspont azonos távolságra van a középponttól). A többi "
"alakzat kimarad."

#: appEditors/appGeoEditor.py:4461
msgid "New Diameter"
msgstr "Új átmérő"

#: appEditors/appGeoEditor.py:4466
msgid "Resize the selected circles to the new diameter, as one Undo/Redo step."
msgstr ""
"A kijelölt körök átméretezése az új átmérőre egyetlen Visszavonás/Ismétlés "
"lépésként."

#: appEditors/appGeoEditor.py:4998
msgid ""
"Select one open LineString before starting Split path. Click its interior; "
"the split tolerance is in current units."
msgstr ""
"Az Útvonal felosztása indítása előtt egy nyitott LineString kijelölése "
"szükséges. Kattintás a belső részére; a felosztási tolerancia az aktuális "
"mértékegységekben értendő."

#: appEditors/appGeoEditor.py:5004
msgid "Select exactly one open LineString and reopen Split path."
msgstr ""
"Pontosan egy nyitott LineString kijelölése, majd az Útvonal felosztása "
"újbóli megnyitása szükséges."

#: appEditors/appGeoEditor.py:5074 appEditors/appGeoEditor.py:5336
