#: appGUI/preferences/general/GeneralAPPSetGroupUI.py:478
#: appGUI/preferences/general/GeneralAppSettingsGroupUI.py:240
msgid ""
"Select the mouse button to use for panning:\n"
"- MMB --> Middle Mouse Button\n"
"- RMB --> Right Mouse Button"
msgstr ""
"A nézet eltolásához használt egérgomb kiválasztása:\n"
"- MMB --> Középső egérgomb\n"
"- RMB --> Jobb egérgomb"

#: appGUI/preferences/general/GeneralAPPSetGroupUI.py:482
#: appGUI/preferences/general/GeneralAppSettingsGroupUI.py:243
msgid "MMB"
msgstr "MMB"

#: appGUI/preferences/general/GeneralAPPSetGroupUI.py:483
