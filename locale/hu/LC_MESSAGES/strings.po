msgstr "eltávolítva"

#: appPlugins/ToolSub/Sub.py:573
msgid "added"
msgstr "hozzáadva"

#: appPlugins/ToolSub/Sub.py:584
msgid "The subtractor has no area."
msgstr "A kivonandónak nincs területe."

#: appPlugins/ToolSub/SubUI.py:36
msgid ""
"Subtract, intersect or XOR the area of one or more Gerber / Geometry / "
"Excellon objects\n"
"with a Gerber, Geometry or Excellon target object."
msgstr ""
"Egy vagy több Gerber / Geometria / Excellon objektum területének kivonása, "
"metszése vagy XOR művelete\n"
"egy Gerber, Geometria vagy Excellon célobjektummal."

#: appPlugins/ToolSub/SubUI.py:64
