#: appPlugins/ToolTransform/Transform.py:793
#: appPlugins/ToolTransform/Transform.py:809
#: appPlugins/ToolTransform/Transform.py:825
msgid "axis done"
msgstr "tengelyen kész"

#: appPlugins/ToolTransform/Transform.py:795
msgid "CNCJob objects can't be skewed."
msgstr "A CNC Munka objektumok nem dönthetők."

#: appPlugins/ToolTransform/Transform.py:807
msgid "Scale on both axes done"
msgstr "Skálázás mindkét tengelyen kész"

#: appPlugins/ToolTransform/Transform.py:809
msgid "Scale on the"
msgstr "Skálázás az"

#: appPlugins/ToolTransform/Transform.py:811
msgid "CNCJob objects can't be scaled."
msgstr "A CNC Munka objektumok nem skálázhatók."

#: appPlugins/ToolTransform/Transform.py:823
#: appPlugins/ToolTransform/Transform.py:837
msgid "CNCJob objects can't be offset."
msgstr "A CNC Munka objektumok nem tolhatók el."

#: appPlugins/ToolTransform/Transform.py:825
msgid "Offset on the"
msgstr "Eltolás az"

#: appPlugins/ToolTransform/Transform.py:839
msgid "Offset on both axes done"
msgstr "Eltolás mindkét tengelyen kész"

#: appPlugins/ToolTransform/Transform.py:861
msgid "CNCJob objects can't be buffered."
msgstr "A CNC Munka objektumokon nem végezhető Buffer művelet."

#: appPlugins/ToolTransform/TransformUI.py:40
msgid "A plugin that allow geometry transformation."
msgstr "Bővítmény geometriák transzformálásához."

#: appPlugins/ToolTransform/TransformUI.py:61
msgid ""
"The reference point for Rotate, Skew, Scale, Mirror.\n"
"Offset does not use a reference point.\n"
"Can be:\n"
"- Origin -> it is the 0, 0 point\n"
"- Selection -> the center of the bounding box of the selected objects\n"
"- Point -> a custom point defined by X,Y coordinates\n"
"- Object -> the center of the bounding box of a specific object"
msgstr ""
"Referenciapont a Forgatás, Döntés, Skálázás és Tükrözés műveletekhez.\n"
"Az Eltolás nem használ referenciapontot.\n"
"Lehet:\n"
"- Origó -> a 0, 0 pont\n"
"- Kijelölés -> a kijelölt objektumok befoglaló keretének középpontja\n"
"- Pont -> X,Y koordinátákkal megadott egyéni pont\n"
"- Objektum -> egy adott objektum befoglaló keretének középpontja"

#: appPlugins/ToolTransform/TransformUI.py:116
msgid ""
"The object used as reference.\n"
"The used point is the center of it's bounding box."
msgstr ""
"Referenciaként használt objektum.\n"
"A használt pont a befoglaló keretének középpontja."

#: appPlugins/ToolTransform/TransformUI.py:156
msgid ""
"Rotate the selected object(s) around the\n"
"reference point selected above."
msgstr ""
"A kijelölt objektum(ok) forgatása a fent\n"
"kiválasztott referenciapont körül."

#: appPlugins/ToolTransform/TransformUI.py:180
msgid ""
"Use the X angle for both axes.\n"
"The Y entry is ignored while linked and kept for when the link is off."
msgstr ""
"Az X szög használata mindkét tengelyhez.\n"
"Összekapcsolt állapotban az Y mező figyelmen kívül marad, és megőrződik a "
"szétkapcsolásig."

#: appPlugins/ToolTransform/TransformUI.py:204
msgid ""
"Skew/shear the selected object(s) on X around the\n"
"reference point selected above."
msgstr ""
"A kijelölt objektum(ok) döntése/nyírása az X tengelyen\n"
"a fent kiválasztott referenciapont körül."

#: appPlugins/ToolTransform/TransformUI.py:224
msgid ""
"Skew/shear the selected object(s) on Y around the\n"
"reference point selected above."
msgstr ""
"A kijelölt objektum(ok) döntése/nyírása az Y tengelyen\n"
"a fent kiválasztott referenciapont körül."

#: appPlugins/ToolTransform/TransformUI.py:232
msgid "Skew X/Y"
msgstr "Döntés X/Y"

#: appPlugins/ToolTransform/TransformUI.py:234
msgid ""
"Skew/shear the selected object(s) using both the X and Y angles\n"
"around the reference point selected above.\n"
"When Link is checked the X angle is used for both."
msgstr ""
"A kijelölt objektum(ok) döntése/nyírása az X és Y szög együttes "
"használatával\n"
"a fent kiválasztott referenciapont körül.\n"
"Ha az Összekapcsolás be van jelölve, mindkettőhöz az X szög kerül "
"felhasználásra."

#: appPlugins/ToolTransform/TransformUI.py:257
msgid ""
"Use the X factor for both axes.\n"
"The Y entry is ignored while linked and kept for when the link is off."
msgstr ""
"Az X tényező használata mindkét tengelyhez.\n"
"Összekapcsolt állapotban az Y mező figyelmen kívül marad, és megőrződik a "
"szétkapcsolásig."

#: appPlugins/ToolTransform/TransformUI.py:279
msgid ""
"Scale the selected object(s) on X around the\n"
"reference point selected above."
msgstr ""
"A kijelölt objektum(ok) skálázása az X tengelyen\n"
"a fent kiválasztott referenciapont körül."

#: appPlugins/ToolTransform/TransformUI.py:298
msgid ""
"Scale the selected object(s) on Y around the\n"
"reference point selected above."
msgstr ""
"A kijelölt objektum(ok) skálázása az Y tengelyen\n"
"a fent kiválasztott referenciapont körül."

#: appPlugins/ToolTransform/TransformUI.py:306
msgid "Scale X/Y"
msgstr "Skálázás X/Y"

#: appPlugins/ToolTransform/TransformUI.py:308
msgid ""
"Scale the selected object(s) using both the X and Y factors\n"
"around the reference point selected above.\n"
"When Link is checked the X factor is used for both."
msgstr ""
"A kijelölt objektum(ok) skálázása az X és Y tényezővel\n"
"a fent kiválasztott referenciapont körül.\n"
"Ha a Csatolás be van jelölve, mindkettőhöz az X tényező érvényes."

#: appPlugins/ToolTransform/TransformUI.py:333
msgid "Flip X"
msgstr "Tükrözés X"

#: appPlugins/ToolTransform/TransformUI.py:335
msgid ""
"Mirror the X coordinate of the selected object(s)\n"
"over the Y axis."
msgstr ""
"A kijelölt objektum(ok) X koordinátájának tükrözése\n"
"az Y tengelyre."

#: appPlugins/ToolTransform/TransformUI.py:338
msgid "Flip Y"
msgstr "Tükrözés Y"

#: appPlugins/ToolTransform/TransformUI.py:340
msgid ""
"Mirror the Y coordinate of the selected object(s)\n"
"over the X axis."
msgstr ""
"A kijelölt objektum(ok) Y koordinátájának tükrözése\n"
"az X tengelyre."

#: appPlugins/ToolTransform/TransformUI.py:372
msgid ""
"Offset the selected object(s) by the X value.\n"
"Offset does not use the reference point."
msgstr ""
"A kijelölt objektum(ok) eltolása az X értékkel.\n"
"Az eltolás nem használja a referenciapontot."

#: appPlugins/ToolTransform/TransformUI.py:391
msgid ""
"Offset the selected object(s) by the Y value.\n"
"Offset does not use the reference point."
msgstr ""
"A kijelölt objektum(ok) eltolása az Y értékkel.\n"
"Az eltolás nem használja a referenciapontot."

#: appPlugins/ToolTransform/TransformUI.py:399
msgid "Offset X/Y"
msgstr "Eltolás X/Y"

#: appPlugins/ToolTransform/TransformUI.py:401
msgid ""
"Offset the selected object(s) by both the X and Y values.\n"
"Offset does not use the reference point."
msgstr ""
"A kijelölt objektum(ok) eltolása az X és Y értékekkel.\n"
"Az eltolás nem használja a referenciapontot."

#: appPlugins/ToolTransform/TransformUI.py:420
msgid ""
"The corner or the center of the combined bounding box of the selected "
"objects\n"
"that Move puts on the point."
msgstr ""
"A kijelölt objektumok közös befoglaló keretének azon sarka vagy "
"középpontja,\n"
"amelyet az Áthelyezés a célpontra helyez."

#: appPlugins/ToolTransform/TransformUI.py:429
msgid "The point in format X,Y where Move puts the reference."
msgstr "A célpont X,Y formátumban, ahová az Áthelyezés a referenciát helyezi."

#: appPlugins/ToolTransform/TransformUI.py:437
msgid ""
"All the selected objects move by the same vector, so that the chosen "
"corner\n"
"of their combined bounding box is on the point."
