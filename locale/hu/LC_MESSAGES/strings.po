msgstr "A FlatCAM felületén használt nyelv beállítása."

#: appGUI/preferences/general/GeneralAppPrefGroupUI.py:254
#: appTranslation.py:124
msgid "Apply Language"
msgstr "Nyelv alkalmazása"

#: appGUI/preferences/general/GeneralAppPrefGroupUI.py:255
msgid ""
"Set the language used throughout FlatCAM.\n"
