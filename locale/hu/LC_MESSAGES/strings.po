msgstr "Balról jobbra kijelölés színe"

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:243
msgid "Set the line color for the 'left to right' selection box."
msgstr "A „balról jobbra” kijelölőkeret vonalszínének beállítása."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:252
msgid ""
"Set the fill color for the selection box\n"
"in case that the selection is done from left to right.\n"
"First 6 digits are the color and the last 2\n"
"digits are for alpha (transparency) level."
msgstr ""
"A kijelölőkeret kitöltési színének beállítása\n"
"balról jobbra történő kijelölés esetén.\n"
"Az első 6 számjegy a színt, az utolsó 2\n"
"számjegy az alfa (átlátszóság) szintjét adja meg."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:265
msgid "Set the fill transparency for the 'left to right' selection box."
msgstr "A „balról jobbra” kijelölőkeret kitöltési átlátszóságának beállítása."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:278
msgid "Right-Left Selection Color"
msgstr "Jobbról balra kijelölés színe"

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:284
msgid "Set the line color for the 'right to left' selection box."
msgstr "A „jobbról balra” kijelölőkeret vonalszínének beállítása."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:294
msgid ""
"Set the fill color for the selection box\n"
"in case that the selection is done from right to left.\n"
"First 6 digits are the color and the last 2\n"
"digits are for alpha (transparency) level."
msgstr ""
"A kijelölőkeret kitöltési színének beállítása\n"
"jobbról balra történő kijelölés esetén.\n"
"Az első 6 számjegy a színt, az utolsó 2\n"
"számjegy az alfa (átlátszóság) szintjét adja meg."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:307
msgid "Set the fill transparency for selection 'right to left' box."
msgstr "A „jobbról balra” kijelölőkeret kitöltési átlátszóságának beállítása."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:323
#: appGUI/preferences/tools/ToolsDistancePrefGroupUI.py:81
msgid "Editor Color"
msgstr "Szerkesztő színe"

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:327
msgid "Drawing"
msgstr "Rajzolás"

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:329
msgid "Set the color for the shape."
msgstr "Az alakzat színének beállítása."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:339
msgid "Set the color of the shape when selected."
msgstr "Az alakzat színének beállítása kijelölt állapotban."

#: appGUI/preferences/general/GeneralGUIPrefGroupUI.py:351
