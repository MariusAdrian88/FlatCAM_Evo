msgstr "Alakzatok kijelölése vagy a művelet megszakítása szükséges."

#: appEditors/appGeoEditor.py:6548 appPlugins/ToolMove/Move.py:247
msgid "Moving"
msgstr "Mozgatás"

#: appEditors/appGeoEditor.py:6726 appEditors/appGeoEditor.py:7219
