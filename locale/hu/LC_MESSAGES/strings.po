msgstr "A rácsnak véges pozitív lépésközökkel kell rendelkeznie."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:226
msgid "Snapping would collapse a track."
msgstr "A rácshoz tapadás nullára zsugorítana egy vezetősávot."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:233
