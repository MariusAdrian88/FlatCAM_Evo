#: appEditors/appGeoEditor.py:5292
msgid ""
"Choose a center and a positive finite radius before completing the circle."
msgstr ""
"Középpont és pozitív véges sugár megadása szükséges a kör befejezése előtt."

#: appEditors/appGeoEditor.py:5363 appEditors/appGerberEditor.py:1939
msgid "Click on Start point ..."
msgstr "Kattintás a kezdőpontra ..."

#: appEditors/appGeoEditor.py:5365 appEditors/appGerberEditor.py:1941
msgid "Click on Point3 ..."
msgstr "Kattintás a 3. pontra ..."

#: appEditors/appGeoEditor.py:5367 appEditors/appGerberEditor.py:1943
msgid "Click on Stop point ..."
msgstr "Kattintás a végpontra ..."

#: appEditors/appGeoEditor.py:5372 appEditors/appGerberEditor.py:1948
msgid "Click on Stop point to complete ..."
msgstr "Kattintás a végpontra a befejezéshez ..."

#: appEditors/appGeoEditor.py:5374 appEditors/appGerberEditor.py:1950
msgid "Click on Point2 to complete ..."
msgstr "Kattintás a 2. pontra a befejezéshez ..."

#: appEditors/appGeoEditor.py:5376 appEditors/appGerberEditor.py:1952
msgid "Click on Center point to complete ..."
msgstr "Kattintás a középpontra a befejezéshez ..."

#: appEditors/appGeoEditor.py:5402 appEditors/appGerberEditor.py:1997
msgid "Mode: Start -> Stop -> Center. Click on Start point ..."
msgstr "Mód: Kezdőpont -> Végpont -> Középpont. Kattintás a kezdőpontra ..."

#: appEditors/appGeoEditor.py:5405 appEditors/appGerberEditor.py:2000
msgid "Mode: Point1 -> Point3 -> Point2. Click on Point1 ..."
msgstr "Mód: 1. pont -> 3. pont -> 2. pont. Kattintás az 1. pontra ..."

#: appEditors/appGeoEditor.py:5408 appEditors/appGerberEditor.py:2003
msgid "Mode: Center -> Start -> Stop. Click on Center point ..."
msgstr "Mód: Középpont -> Kezdőpont -> Végpont. Kattintás a középpontra ..."

#: appEditors/appGeoEditor.py:5594 appEditors/appGeoEditor.py:5855
#: appEditors/appGeoEditor.py:5940
#: appEditors/geo_plugins/GeoRectanglePlugin.py:104
msgid "Click on 1st corner ..."
msgstr "Kattintás az 1. sarokra ..."

#: appEditors/appGeoEditor.py:5624
msgid ""
"Click on 1st corner to add a new rectangle or Apply to change the selection."
msgstr ""
"Kattintás az 1. sarokra új téglalap hozzáadásához, vagy Alkalmazás a "
"kijelölés módosításához."

#: appEditors/appGeoEditor.py:5630
msgid "Choose a finite opposite corner with nonzero length and width."
msgstr ""
"Véges, nem nulla hosszúságú és szélességű szemközti sarok kiválasztása "
"szükséges."

#: appEditors/appGeoEditor.py:5637
msgid "Click on opposite corner to complete ..."
msgstr "Kattintás a szemközti sarokra a befejezéshez ..."

#: appEditors/appGeoEditor.py:5704
msgid "Choose two finite opposite corners with nonzero length and width."
msgstr ""
"Két véges, nem nulla hosszúságú és szélességű szemközti sarok kiválasztása "
"szükséges."

#: appEditors/appGeoEditor.py:5737 appEditors/appGeoEditor.py:5753
msgid "Click on the first corner point before entering dimensions."
msgstr "Kattintás az első sarokpontra a méretek megadása előtt."

#: appEditors/appGeoEditor.py:5790
msgid "Enter finite nonzero length and width values."
msgstr "Véges, nem nulla hosszúság- és szélességértékek megadása szükséges."

#: appEditors/appGeoEditor.py:5794
msgid "Enter smaller dimensions so the projected coordinates remain finite."
msgstr ""
"Kisebb méretek megadása szükséges, hogy a kivetített koordináták végesek "
"maradjanak."

#: appEditors/appGeoEditor.py:5801 appEditors/appGeoEditor.py:5998
#: appEditors/appGeoEditor.py:6306 appEditors/appGerberEditor.py:507
#: appEditors/appGerberEditor.py:1318
msgid "Projected"
msgstr "Kivetített"

#: appEditors/appGeoEditor.py:5802
