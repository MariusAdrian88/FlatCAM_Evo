#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:214
msgid ""
"Distance above the contact to retract to after a successful probe. Must be "
"positive."
msgstr ""
"Az a távolság az érintkezési pont felett, amelyre sikeres tapintás után az "
"eszköz visszahúzódik. Pozitív értéknek kell lennie."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:220
#: appPlugins/ToolGcodeSender/SenderUI.py:473
msgid "Probe feedrate"
msgstr "Tapintási sebesség"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:222
msgid "Feedrate of the probe move. Must be positive."
msgstr "A tapintási mozgás sebessége. Pozitív értéknek kell lennie."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:228
msgid "Plate position tolerance"
msgstr "Tapintólap pozíciótűrése"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:230
msgid ""
"Largest XY distance between the fixed reference contact and a later "
"measurement. Must be positive."
msgstr ""
"A fix referencia-érintkezés és egy későbbi mérés közötti legnagyobb XY "
"távolság. Pozitív értéknek kell lennie."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:236
msgid "Removable plate thickness"
msgstr "Eltávolítható lap vastagsága"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:238
msgid "Thickness of the removable plate placed on the PCB. Must be positive."
msgstr ""
"A NYÁK-ra helyezett eltávolítható lap vastagsága. Pozitív értéknek kell "
"lennie."

#: appGUI/preferences/tools/ToolsISOPrefGroupUI.py:21
