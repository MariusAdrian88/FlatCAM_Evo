msgstr "A manuális tartóhíd nem képezhető le a kijelölt kontúrra."

#: appPlugins/ToolCutOut/CutOutGen.py:316
msgid "Manual gap length must be a finite value."
msgstr "A manuális tartóhíd hosszának véges értéknek kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:332
msgid "Could not find the selected contour for the manual gap."
msgstr "A kijelölt kontúr nem található a manuális tartóhídhoz."

#: appPlugins/ToolCutOut/CutOutGen.py:415
#: appPlugins/ToolCutOut/CutOutGen.py:451
#: appPlugins/ToolCutOut/CutOutGen.py:728
msgid "Cutout gaps failed: %s"
msgstr "Kivágási tartóhidak létrehozása sikertelen: %s"

