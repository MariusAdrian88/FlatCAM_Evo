msgid "No Gerber object is selected."
msgstr "Nincs kijelölt Gerber objektum."

#: appPlugins/ToolEtchCompensation/EtchCompensation.py:253
msgid "Another Etch Compensation run is still working."
msgstr "Egy másik maratáskompenzációs futás még folyamatban van."

#: appPlugins/ToolEtchCompensation/EtchCompensation.py:265
msgid "The lateral offset is zero. Nothing was created."
msgstr "Az oldalirányú eltolás nulla. Nem jött létre semmi."

#: appPlugins/ToolEtchCompensation/EtchCompensation.py:318
#: appPlugins/ToolEtchCompensation/EtchCompensation.py:321
