#: appEditors/grb_plugins/GrbSelectionPlugin.py:144
msgid "Rows and columns must be at least 1, and not both 1."
msgstr ""
"A sorok és oszlopok számának legalább 1-nek kell lennie, és nem lehet "
"mindkettő 1."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:146
msgid "Choose finite X and Y distances."
msgstr "Véges X és Y távolságok megadása szükséges."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:173
msgid "The target aperture does not exist."
msgstr "A célapertúra nem létezik."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:177
msgid "Select features that are not in the target aperture."
msgstr "A célapertúrán kívüli elemek kijelölése szükséges."

