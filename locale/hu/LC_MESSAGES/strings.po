msgstr "X min"

#: appPlugins/ToolDblSided/DblSidedUI.py:95
#: appPlugins/ToolDblSided/DblSidedUI.py:104
msgid "Minimum location."
msgstr "Minimális pozíció."

#: appPlugins/ToolDblSided/DblSidedUI.py:103
