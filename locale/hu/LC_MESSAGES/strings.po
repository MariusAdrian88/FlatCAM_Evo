msgstr "grblHAL nyers TCP host/IP megbízható LAN hálózaton."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:46
msgid "grblHAL transport"
msgstr "grblHAL átvitel"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:47
msgid "Serial port"
msgstr "Soros port"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:48
