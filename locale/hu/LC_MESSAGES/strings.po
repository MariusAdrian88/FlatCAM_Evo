msgstr "Y min"

#: appPlugins/ToolDblSided/DblSidedUI.py:112
msgid "X max"
msgstr "X max"

#: appPlugins/ToolDblSided/DblSidedUI.py:113
#: appPlugins/ToolDblSided/DblSidedUI.py:122
msgid "Maximum location."
msgstr "Maximális pozíció."

#: appPlugins/ToolDblSided/DblSidedUI.py:121
msgid "Y max"
msgstr "Y max"

