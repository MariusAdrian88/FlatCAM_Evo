msgstr "Port leválasztva."

#: appPlugins/Common/grbl/grbl_client.py:661
msgid "GRBL needs recovery. Press Reset, then Home."
msgstr ""
"A GRBL helyreállítást igényel. A Reset, majd a Home gomb megnyomása "
