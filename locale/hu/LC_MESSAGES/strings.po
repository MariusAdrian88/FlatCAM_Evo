#: appEditors/grb_plugins/GrbDrawingPlugin.py:28
msgid ""
"Enter finite coordinates, positive dimensions and a corner radius smaller "
"than half the size."
msgstr ""
"Véges koordináták, pozitív méretek és a méret felénél kisebb saroksugár "
"megadása szükséges."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:49
msgid "Enter text, a positive font size and finite coordinates and rotation."
msgstr ""
"Szöveg, pozitív betűméret, valamint véges koordináták és elforgatás "
"megadása szükséges."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:51
msgid "Bitmap smoothing must be a finite nonnegative number."
msgstr "A bittérkép-simításnak véges, nem negatív számnak kell lennie."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:63
msgid "Enter a valid polygon and finite nonnegative clearance."
msgstr "Érvényes poligon és véges, nem negatív hézag megadása szükséges."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:70
msgid "Clearance exceeds the coordinate range."
msgstr "A hézag túllépi a koordinátatartományt."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:82
msgid "Source contains invalid polygon material."
msgstr "A forrás érvénytelen poligonanyagot tartalmaz."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:110
msgid "Explicit material regions. Dimensions use %s; font size uses points."
msgstr ""
"Explicit anyagrégiók. A méretek mértékegysége %s; a betűméret pontban "
"értendő."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:119
msgid "Creates new material; existing features aren't replaced."
msgstr "Új anyagot hoz létre; a meglévő elemeket nem cseréli le."

#: appEditors/grb_plugins/GrbDrawingPlugin.py:129
msgid "Baseline X"
msgstr "Alapvonal X"

#: appEditors/grb_plugins/GrbDrawingPlugin.py:130
msgid "Baseline Y"
msgstr "Alapvonal Y"

#: appEditors/grb_plugins/GrbDrawingPlugin.py:136
msgid "Rotation (degrees, about anchor)"
msgstr "Forgatás (fok, horgonypont körül)"

#: appEditors/grb_plugins/GrbDrawingPlugin.py:260
msgid "Editor session or units changed. Reopen the drawing tool."
msgstr ""
"A szerkesztő munkamenete vagy a mértékegységek megváltoztak. A rajzeszköz "
"újranyitása szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:25
msgid "Select distinct stored features first."
msgstr "Először különböző tárolt elemek kijelölése szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:32
msgid "Each selected feature must have exactly one aperture owner."
msgstr ""
"Minden kijelölt elemnek pontosan egy tulajdonos apertúrával kell "
"rendelkeznie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:41
msgid "Only plain circular apertures without holes or macros are supported."
msgstr ""
"Csak egyszerű, lyukak és makrók nélküli kör alakú apertúrák támogatottak."

#: appEditors/grb_plugins/GrbFollowPlugin.py:68
msgid "The selected FOLLOW contains a branch, crossing or overlap."
msgstr "A kijelölt FOLLOW elágazást, kereszteződést vagy átfedést tartalmaz."

#: appEditors/grb_plugins/GrbFollowPlugin.py:72
msgid "Branching FOLLOW endpoints cannot be edited."
msgstr "Az elágazó FOLLOW végpontok nem szerkeszthetők."

#: appEditors/grb_plugins/GrbFollowPlugin.py:104
msgid "Split FOLLOW path"
msgstr "FOLLOW útvonal felosztása"

#: appEditors/grb_plugins/GrbFollowPlugin.py:110
msgid "Select exactly one open circular-aperture FOLLOW path to split."
msgstr ""
"A felosztáshoz pontosan egy nyitott, kör alakú apertúrához tartozó FOLLOW "
"útvonal kijelölése szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:122
msgid "Split tolerance must be finite and nonnegative."
msgstr "A felosztási tűrésnek végesnek és nem negatívnak kell lennie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:125
msgid "Choose finite X and Y split coordinates."
msgstr "Véges X és Y felosztási koordináták megadása szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:128
msgid "The FOLLOW path must have finite positive length."
msgstr "A FOLLOW útvonalnak véges, pozitív hosszúságúnak kell lennie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:133
msgid ""
"Click inside the FOLLOW path, within tolerance and away from its endpoints."
msgstr ""
"A FOLLOW útvonal belsejébe kell kattintani, a tűréshatáron belül és a "
"végpontoktól távol."

#: appEditors/grb_plugins/GrbFollowPlugin.py:136
msgid "The split must produce two valid nonzero-length FOLLOW paths."
msgstr ""
"A felosztásnak két érvényes, nem nulla hosszúságú FOLLOW útvonalat kell "
"eredményeznie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:140
msgid ""
"This split would change the material footprint. Choose another split point."
msgstr ""
"Ez a felosztás megváltoztatná az anyag kiterjedését. Másik felosztási pont "
"választása szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:142
#: appEditors/grb_plugins/GrbFollowPlugin.py:235
#: appEditors/grb_plugins/GrbFollowPlugin.py:291
msgid ""
"Geometry or selection changed during the operation. Select the features "
"again."
msgstr ""
"A geometria vagy a kijelölés megváltozott a művelet közben. Az elemek "
"újbóli kijelölése szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:151
msgid "Join FOLLOW paths"
msgstr "FOLLOW útvonalak összekapcsolása"

#: appEditors/grb_plugins/GrbFollowPlugin.py:157
msgid "Join tolerance must be finite and nonnegative."
msgstr "Az összekapcsolási tűrésnek végesnek és nem negatívnak kell lennie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:163
msgid ""
"Select at least two open FOLLOW paths belonging to the same circular "
"aperture."
msgstr ""
"Legalább két nyitott, ugyanahhoz a kör alakú apertúrához tartozó FOLLOW "
"útvonal kijelölése szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:169
msgid "The selected paths use incompatible circular sweeps."
msgstr "A kijelölt útvonalak inkompatibilis kör alakú pályákat használnak."

#: appEditors/grb_plugins/GrbFollowPlugin.py:178
#: appEditors/grb_plugins/GrbFollowPlugin.py:191
msgid "Joined FOLLOW records must have compatible components and polarity."
msgstr ""
"Az összekapcsolt FOLLOW rekordoknak kompatibilis komponensekkel és "
"polaritással kell rendelkezniük."

#: appEditors/grb_plugins/GrbFollowPlugin.py:187
msgid "The FOLLOW paths must have finite positive lengths."
msgstr "A FOLLOW útvonalaknak véges, pozitív hosszúságúnak kell lenniük."

#: appEditors/grb_plugins/GrbFollowPlugin.py:203
msgid ""
"Gerber joins require coincident endpoints; bridging a gap changes material."
msgstr ""
"A Gerber csatlakoztatáshoz egybeeső végpontok szükségesek; a rés áthidalása "
"megváltoztatja az anyagot."

#: appEditors/grb_plugins/GrbFollowPlugin.py:224
msgid "Join would create a ring, branch, overlap or invalid FOLLOW."
msgstr ""
"A csatlakoztatás gyűrűt, elágazást, átfedést vagy érvénytelen FOLLOW "
"útvonalat hozna létre."

#: appEditors/grb_plugins/GrbFollowPlugin.py:231
msgid "No selected endpoints can be joined."
msgstr "Nincs csatlakoztatható kijelölt végpont."

#: appEditors/grb_plugins/GrbFollowPlugin.py:244
msgid "Resize circular flashes"
msgstr "Kör alakú flash-ek átméretezése"

#: appEditors/grb_plugins/GrbFollowPlugin.py:250
msgid "The new diameter must be a finite positive number."
msgstr "Az új átmérőnek véges pozitív számnak kell lennie."

#: appEditors/grb_plugins/GrbFollowPlugin.py:265
msgid "Select unmodified circular flashes without clear geometry."
msgstr ""
"Módosítatlan, clear geometria nélküli kör alakú flash-ek kijelölése "
"szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:271
msgid ""
"The flash solid does not match a plain circular aperture. Resize cancelled."
msgstr ""
"A flash solid geometriája nem egyezik meg egy egyszerű kör alakú "
"apertúrával. Az átméretezés megszakítva."

#: appEditors/grb_plugins/GrbFollowPlugin.py:284
msgid "The new diameter produces invalid circular geometry."
msgstr "Az új átmérő érvénytelen kör alakú geometriát eredményez."

#: appEditors/grb_plugins/GrbFollowPlugin.py:289
msgid ""
"No circular flash needs resizing. Select circular flashes with a different "
"diameter."
msgstr ""
"Egyetlen kör alakú flash sem igényel átméretezést. Eltérő átmérőjű kör "
"alakú flash-ek kijelölése szükséges."

#: appEditors/grb_plugins/GrbFollowPlugin.py:306
msgid "{n} circular flashes resized"
msgstr "{n} kör alakú flash átméretezve"

#: appEditors/grb_plugins/GrbFollowPlugin.py:322
msgid "Select one circular FOLLOW path, then click its interior to split it."
msgstr ""
"Egy kör alakú FOLLOW útvonal kijelölése, majd kattintás a belsejébe a "
"felosztáshoz."

#: appEditors/grb_plugins/GrbFollowPlugin.py:326
msgid "Select one FOLLOW path and reopen Split path."
msgstr ""
"Egy FOLLOW útvonal kijelölése, majd az Útvonal felosztása újbóli megnyitása "
"szükséges."

#: appEditors/grb_plugins/GrbHistory.py:87
