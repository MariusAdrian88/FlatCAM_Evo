msgstr "Flash-ek vagy vezetősávok kijelölése szükséges a rácshoz tapadáshoz."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:250
msgid ""
"Click a track to select the chain of tracks that it belongs to. Shift adds "
"to the selection."
msgstr ""
"Kattintás egy vezetősávra a hozzá tartozó vezetősávlánc kijelöléséhez. A "
"Shift hozzáad a kijelöléshez."

#: appEditors/grb_plugins/GrbTrackBend.py:61
msgid "The bend would collapse an adjacent segment."
msgstr "A töréspont nullára zsugorítana egy szomszédos szakaszt."

#: appEditors/grb_plugins/GrbTrackBend.py:64
msgid "The bend would create an invalid or self-intersecting track."
msgstr "A töréspont érvénytelen vagy önmagát metsző vezetősávot hozna létre."

#: appEditors/grb_plugins/GrbTrackBend.py:76
msgid ""
"Choose an open, unmodified circular-aperture track without clear geometry."
msgstr ""
"Nyitott, módosítatlan, kör alakú apertúrájú, clear geometria nélküli "
"vezetősáv kiválasztása szükséges."

#: appEditors/grb_plugins/GrbTrackBend.py:80
msgid "The track contains invalid coordinates or zero-length segments."
msgstr ""
"A vezetősáv érvénytelen koordinátákat vagy nulla hosszúságú szakaszokat "
"tartalmaz."

#: appEditors/grb_plugins/GrbTrackBend.py:98
msgid ""
"The solid no longer matches the circular aperture and FOLLOW. Bend editing "
"was cancelled."
msgstr ""
"A solid geometria már nem egyezik meg a kör alakú apertúrával és a FOLLOW "
"útvonallal. A töréspont szerkesztése megszakítva."

#: appEditors/grb_plugins/GrbTrackBend.py:128
msgid "Click near a track bend or a two-record track join."
msgstr ""
"Kattintás egy vezetősáv töréspontja vagy egy kételemes "
"vezetősáv-csatlakozás közelébe."

#: appEditors/grb_plugins/GrbTrackBend.py:131
msgid "Several bends are equally near. Zoom in and choose one."
msgstr ""
"Több töréspont is azonos távolságra van. Nagyítás és egyetlen pont "
"kiválasztása szükséges."

#: appEditors/grb_plugins/GrbTrackBend.py:141
msgid "The bend meets another track. Junction editing is not supported."
msgstr ""
"A töréspont egy másik vezetősávval találkozik. A csomópontok szerkesztése "
"nem támogatott."

#: appEditors/grb_plugins/GrbTrackBend.py:146
msgid "An endpoint needs exactly one same-aperture continuation."
msgstr "Egy végponthoz pontosan egy azonos apertúrájú folytatás szükséges."

#: appEditors/grb_plugins/GrbTrackBend.py:149
msgid "Choose a bend, not a branch or a mixed-aperture junction."
msgstr ""
"Töréspont kiválasztása szükséges, nem elágazás vagy vegyes apertúrájú "
"csomópont."

#: appEditors/grb_plugins/GrbTrackBend.py:166
msgid ""
"An adjacent run contains a junction or overlap. Bend editing was cancelled."
msgstr ""
"Egy szomszédos szakasz csomópontot vagy átfedést tartalmaz. A töréspont "
"szerkesztése megszakítva."

#: appEditors/grb_plugins/GrbTrackBend.py:171
msgid "Bend coordinates must be finite two-dimensional numbers."
msgstr "A töréspont koordinátáinak véges kétdimenziós számoknak kell lenniük."

#: appEditors/grb_plugins/GrbTrackBend.py:177
msgid "The bend would create invalid solid geometry."
msgstr "A töréspont érvénytelen solid geometriát hozna létre."

#: appEditors/grb_plugins/GrbTrackBend.py:184
msgid "The two adjacent tracks would overlap or cross."
msgstr "A két szomszédos vezetősáv átfedné vagy keresztezné egymást."

#: appEditors/grb_plugins/GrbTrackBend.py:211
msgid "Move track bend"
msgstr "Vezetősáv töréspontjának áthelyezése"

#: appEditors/grb_plugins/GrbTrackBend.py:214
#: appEditors/grb_plugins/GrbTrackBend.py:219
msgid "Geometry changed during the drag. Pick the bend again."
msgstr ""
"A geometria megváltozott a húzás közben. A töréspont újbóli kiválasztása "
"szükséges."

#: appEditors/grb_plugins/GrbTrackBend.py:230
msgid ""
"Drag a circular-aperture FOLLOW bend. Arc samples are polyline vertices, "
"not arc handles."
msgstr ""
"Kör alakú apertúrájú FOLLOW töréspont húzása. Az ívminták "
"töröttvonal-csúcspontok, nem ívfogópontok."

#: appEditors/grb_plugins/GrbTrackBend.py:235
msgid "Bend coordinates must be finite."
msgstr "A töréspont koordinátáinak végesnek kell lenniük."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:56
msgid "Choose finite X and Y coordinates."
msgstr "Véges X és Y koordináták megadása szükséges."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:63
msgid "The rectangle must have finite coordinates."
msgstr "A téglalapnak véges koordinátákkal kell rendelkeznie."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:83
msgid ""
"Only circular-aperture tracks without clear geometry can be rebuilt. "
"Aperture %(code)s: type=%(type)r, size=%(size)r, clear=%(clear)s."
msgstr ""
"Csak kör alakú apertúrájú, clear geometria nélküli vezetősávok építhetők "
"újra. Apertúra %(code)s: típus=%(type)r, méret=%(size)r, clear=%(clear)s."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:166
msgid "Regions with clear geometry can't be clipped."
msgstr "Clear geometriával rendelkező régiók nem vághatók le."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:182 appGUI/MainGUI.py:994
msgid "Clip"
msgstr "Levágás"

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:188
#: appEditors/grb_plugins/GrbTrackEditPlugin.py:215
