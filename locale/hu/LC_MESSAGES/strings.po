#: appPlugins/ToolExtract/Extract.py:587
#: appPlugins/ToolInvertGerber/InvertGerber.py:282
#: appPlugins/ToolInvertGerber/InvertGerber.py:284
#: appPlugins/ToolSub/Sub.py:572
msgid "Created"
msgstr "Létrehozva"

#: appPlugins/ToolEtchCompensation/EtchCompensation.py:366
#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:186
msgid "Lateral offset"
msgstr "Oldalirányú eltolás"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:49
msgid "Gerber object that will be compensated."
msgstr "A kompenzálandó Gerber objektum."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:63
msgid "Use all selected Gerber objects"
msgstr "Összes kijelölt Gerber objektum használata"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:65
msgid ""
"When checked, every selected Gerber object is compensated, each into its "
"own new object.\n"
"When unchecked, only the object chosen above is compensated."
msgstr ""
"Bejelölve minden kijelölt Gerber objektum kompenzálásra kerül, mindegyik "
"külön új objektumba.\n"
"Bejelölés nélkül csak a fent kiválasztott objektum kerül kompenzálásra."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:72
msgid "Conversion utilities"
msgstr "Átváltási segédeszközök"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:79
msgid "Oz to Microns"
msgstr "Oz → mikron"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:81
msgid ""
"Will convert from oz thickness to microns [um].\n"
"Can use formulas with operators: /, *, +, -, %, .\n"
"The real numbers use the dot decimals separator."
msgstr ""
"Átváltja az oz vastagságot mikronra [um].\n"
"Használhatók képletek a következő operátorokkal: /, *, +, -, %, .\n"
"A valós számok a pontot használják tizedeselválasztóként."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:88
msgid "Oz value"
msgstr "Oz érték"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:90
#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:108
msgid "Microns value"
msgstr "Mikron érték"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:97
msgid "Mils to Microns"
msgstr "Mil → mikron"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:99
msgid ""
"Will convert from mils to microns [um].\n"
"Can use formulas with operators: /, *, +, -, %, .\n"
"The real numbers use the dot decimals separator."
msgstr ""
"Átváltja a mil értéket mikronra [um].\n"
"Használhatók képletek a következő operátorokkal: /, *, +, -, %, .\n"
"A valós számok a pontot használják tizedeselválasztóként."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:106
msgid "Mils value"
msgstr "Mil érték"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:124
msgid "Copper Thickness"
msgstr "Rézvastagság"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:125
msgid ""
"The thickness of the copper foil.\n"
"In microns [um]."
msgstr ""
"A rézfólia vastagsága.\n"
"Mikronban [um]."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:135
msgid ""
"How the lateral offset is found:\n"
"- Etch Factor -> offset = thickness / etch factor, with a factor entered by "
"the user\n"
"- Etchants list -> offset = thickness / etch factor of the chosen etchant\n"
"- Manual offset -> the offset is entered directly"
msgstr ""
"Az oldalirányú eltolás meghatározásának módja:\n"
"- Maratási tényező -> eltolás = vastagság / maratási tényező, a felhasználó "
"által megadott tényezővel\n"
"- Maratószerek listája -> eltolás = vastagság / a kiválasztott maratószer "
"maratási tényezője\n"
"- Kézi eltolás -> az eltolás közvetlenül kerül megadásra"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:152
msgid "Etchants"
msgstr "Maratószerek"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:154
msgid ""
"A list of etchants. F is the etch factor of the etchant: depth etch / "
"lateral etch."
msgstr ""
"Maratószerek listája. Az F a maratószer maratási tényezője: mélységi "
"maratás / oldalirányú maratás."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:164
msgid ""
"The etch factor F: the ratio between depth etch and lateral etch.\n"
"The lateral offset is the copper thickness divided by F.\n"
"Must be greater than zero. Accepts real numbers and formulas using the "
"operators: /,*,+,-,%"
msgstr ""
"Az F maratási tényező: a mélységi maratás és az oldalirányú maratás "
"aránya.\n"
"Az oldalirányú eltolás a rézvastagság és az F hányadosa.\n"
"Nullánál nagyobbnak kell lennie. Elfogad valós számokat és képleteket a "
"következő operátorokkal: /,*,+,-,%"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:169
msgid "Real number or formula"
msgstr "Valós szám vagy képlet"

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:175
msgid ""
"Value with which to increase (positive) or decrease (negative) the copper "
"features.\n"
"In microns [um]."
msgstr ""
"Érték, amellyel a rézelemek növelésre (pozitív) vagy csökkentésre (negatív) "
"kerülnek.\n"
"Mikronban [um]."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:188
msgid ""
"The offset that Compensate will apply to the copper, in microns and in "
"application units."
msgstr ""
"Az eltolás, amelyet a Kompenzálás a rézre alkalmaz, mikronban és az "
"alkalmazás mértékegységeiben."

#: appPlugins/ToolEtchCompensation/EtchCompensationUI.py:203
#: appPlugins/ToolFollow/FollowUI.py:203
#: appPlugins/ToolGcodeSender/SenderCameraUI.py:199
