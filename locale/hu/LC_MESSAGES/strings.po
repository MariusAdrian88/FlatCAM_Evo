msgstr "Hálózati host/IP"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:49
#: appPlugins/ToolGcodeSender/SenderUI.py:224
msgid "Network port"
msgstr "Hálózati port"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:52
msgid "Keep the machine connection on a new project"
msgstr "Gépkapcsolat megtartása új projektnél"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:54
msgid ""
"A new project, a project open or Close All keep a connected machine and its "
"job running.\n"
"Off: ask what to do."
msgstr ""
"Új projekt, projekt megnyitása vagy Összes bezárása esetén a gépkapcsolat "
"és a futó feladat megmarad.\n"
"Kikapcsolva: rákérdezés a teendőre."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:74
#: appHandlers/appIO.py:657 appPlugins/ToolGcodeSender/SenderUI.py:355
msgid "Step"
msgstr "Lépés"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:76
#: appPlugins/ToolGcodeSender/SenderUI.py:357
msgid "Each jog action will move the axes with this value."
msgstr "Minden kézi léptetés (jog) ekkora értékkel mozdítja el a tengelyeket."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:89
#: appPlugins/ToolGcodeSender/SenderUI.py:371
msgid "Feedrate when jogging."
msgstr "Mozgatási sebesség kézi léptetéskor (jog)."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:102
msgid "Safe height (Z) distance when jogging to origin."
msgstr "Biztonsági Z magasság az origóhoz történő kézi mozgatáskor."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:113
msgid "Baud rate"
msgstr "Baudráta"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:115
msgid "The baud rate that is selected for the serial connection."
msgstr "A soros kapcsolathoz kiválasztott baudráta."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:127
msgid "Arcs"
msgstr "Ívek"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:129
msgid ""
"Split: the sender splits G2/G3 arcs into G1 lines.\n"
"Send: the sender sends G2/G3 to GRBL.\n"
"With autolevelling on, arcs are always split."
msgstr ""
"Felosztás: a küldő a G2/G3 íveket G1 vonalakra osztja.\n"
"Küldés: a küldő a G2/G3 parancsokat közvetlenül a GRBL vezérlőnek küldi.\n"
"Bekapcsolt autoszintezésnél az ívek mindig felosztásra kerülnek."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:137
#: appPlugins/ToolGcodeSender/Sender.py:268
#: appPlugins/ToolGcodeSender/SenderUI.py:537
msgid "Send"
msgstr "Küldés"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:145
msgid "Arc segment"
msgstr "Ívszakasz"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:147
msgid "The length of the G1 lines that replace an arc."
msgstr "Az ívet helyettesítő G1 vonalak hossza."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:158
msgid "Segment length"
msgstr "Szakaszhossz"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:160
msgid ""
"Longest G1 line when the G-code is not segmented.\n"
"Used only with autolevelling."
msgstr ""
"A leghosszabb G1 vonal, ha a GCode nincs szegmentálva.\n"
"Csak autoszintezéssel együtt használatos."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:173
msgid "Status interval (ms)"
msgstr "Állapotidőköz (ms)"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:175
msgid "How often the sender asks GRBL for a status report."
msgstr "Milyen gyakran kér állapotjelentést a küldő a GRBL vezérlőtől."

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:185
msgid "Tool-change touchplate"
msgstr "Eszközcsere tapintólap"

#: appGUI/preferences/tools/ToolsGrblSenderPrefGroupUI.py:187
msgid ""
"Disabled: disable calibrated tool-change measurement.\n"
"Fixed: use a fixed touchplate calibrated against the reference tool.\n"
"Removable: use a touchplate placed on the PCB, accounting for its thickness."
msgstr ""
"Letiltva: kalibrált eszközcsere-mérés kikapcsolása.\n"
"Fix: a referenciaeszközhöz kalibrált fix tapintólap használata.\n"
"Eltávolítható: a NYÁK-ra helyezett tapintólap használata, a vastagság "
"figyelembevételével."

