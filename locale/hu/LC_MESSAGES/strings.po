#: appEditors/appGeoEditor.py:6053 appEditors/appGeoEditor.py:6228
#: appEditors/appGeoEditor.py:7286 appEditors/appGerberEditor.py:1114
#: appEditors/appGerberEditor.py:1381
msgid "Click on 1st point ..."
msgstr "Kattintás az 1. pontra ..."

#: appEditors/appGeoEditor.py:6104
msgid "Choose at least two distinct finite points to complete the path."
msgstr ""
"Legalább két különböző, véges pont kiválasztása szükséges az útvonal "
"befejezéséhez."

#: appEditors/appGeoEditor.py:6262
msgid "Click on the first point before entering a length."
msgstr "Kattintás az első pontra a hossz megadása előtt."

#: appEditors/appGeoEditor.py:6268 appEditors/appGeoEditor.py:6732
#: appEditors/appGeoEditor.py:7225
msgid "Enter a finite nonzero length."
msgstr "Véges, nem nulla hossz megadása szükséges."

#: appEditors/appGeoEditor.py:6288
msgid "Move the cursor away from the last point to set a finite direction."
msgstr ""
"A kurzor elmozdítása az utolsó ponttól szükséges a véges irány megadásához."

#: appEditors/appGeoEditor.py:6298 appEditors/appGeoEditor.py:6754
#: appEditors/appGeoEditor.py:7247
msgid "Enter a smaller length so the projected coordinates remain finite."
msgstr ""
"Kisebb hossz megadása szükséges, hogy a kivetített koordináták végesek "
"maradjanak."

#: appEditors/appGeoEditor.py:6480 appEditors/appGeoEditor.py:6519
#: appEditors/appGeoEditor.py:6814 appEditors/appGeoEditor.py:6853
