"Kijelölés és újrapróbálás szükséges."

#: appPlugins/ToolCutOut/CutOut.py:1408
msgid ""
"The selected object has to be of Gerber type.\n"
"Select a Gerber file and try again."
msgstr ""
"A kijelölt objektumnak Gerber típusúnak kell lennie.\n"
"Gerber fájl kijelölése és újrapróbálás szükséges."

#: appPlugins/ToolCutOut/CutOut.py:1548
msgid ""
"Bridge selected. Drag the orange grip or click a new position to move; "
"Delete removes. Right-click keeps it and finishes; Escape cancels the "
"entire session."
msgstr ""
"Tartóhíd kijelölve. Áthelyezés a narancssárga fogópont húzásával vagy új "
"pozícióra kattintással; eltávolítás: Delete. Jobb kattintás: megtartás és "
"befejezés; Escape: a teljes munkamenet megszakítása."

#: appPlugins/ToolCutOut/CutOut.py:1630
msgid "Finished manual adding of gaps."
msgstr "Tartóhidak manuális hozzáadása befejezve."

#: appPlugins/ToolCutOut/CutOutGen.py:65
msgid "Cut Z and Thin Depth must be finite values."
msgstr ""
"A Z marási mélységnek és a Vékony mélységnek véges értéknek kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:67
msgid "Cut Z must be a finite negative value for Thin gaps."
msgstr ""
"A Z marási mélységnek véges negatív értéknek kell lennie a vékony "
"tartóhidakhoz."

#: appPlugins/ToolCutOut/CutOutGen.py:71
msgid "Thin Depth must be zero or satisfy Cut Z < Thin Depth < 0."
msgstr ""
"A Vékony mélységnek nullának kell lennie, vagy teljesítenie kell a Z marási "
"mélység < Vékony mélység < 0 feltételt."

#: appPlugins/ToolCutOut/CutOutGen.py:118
msgid "Gaps value is not supported."
msgstr "A tartóhidak értéke nem támogatott."

#: appPlugins/ToolCutOut/CutOutGen.py:154
#: appPlugins/ToolCutOut/CutOutGen.py:236
msgid "Tool diameter must be a positive finite number."
msgstr "Az eszközátmérőnek pozitív, véges számnak kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:156
msgid "Gap width must be a positive finite number."
msgstr "A hídszélességnek pozitív, véges számnak kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:162
msgid "Requested gaps do not fit on the selected contour."
msgstr "A kért tartóhidak nem férnek el a kijelölt kontúron."

#: appPlugins/ToolCutOut/CutOutGen.py:173
msgid "Requested gap does not fit on the selected open contour."
msgstr "A kért tartóhíd nem fér el a kijelölt nyitott kontúron."

#: appPlugins/ToolCutOut/CutOutGen.py:189
#: appPlugins/ToolCutOut/CutOutGen.py:195
#: appPlugins/ToolCutOut/CutOutGen.py:200
msgid "Requested gaps overlap or touch on the selected contour."
msgstr "A kért tartóhidak átfedik vagy érintik egymást a kijelölt kontúron."

#: appPlugins/ToolCutOut/CutOutGen.py:220
msgid "Requested gaps would remove the complete contour."
msgstr "A kért tartóhidak eltávolítanák a teljes kontúrt."

#: appPlugins/ToolCutOut/CutOutGen.py:228
msgid "No contour is available for a manual gap."
msgstr "Nem áll rendelkezésre kontúr manuális tartóhídhoz."

#: appPlugins/ToolCutOut/CutOutGen.py:233
msgid "Tool diameter and gap width must be finite values."
msgstr "Az eszközátmérőnek és a hídszélességnek véges értéknek kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:238
msgid "Gap width must be a non-negative finite number."
msgstr "A hídszélességnek nem negatív, véges számnak kell lennie."

#: appPlugins/ToolCutOut/CutOutGen.py:244
#: appPlugins/ToolCutOut/CutOutGen.py:259
#: appPlugins/ToolCutOut/CutOutGen.py:262
msgid "Requested manual gap does not fit on the selected contour."
msgstr "A kért manuális tartóhíd nem fér el a kijelölt kontúron."

#: appPlugins/ToolCutOut/CutOutGen.py:292
#: appPlugins/ToolCutOut/CutOutGen.py:319
