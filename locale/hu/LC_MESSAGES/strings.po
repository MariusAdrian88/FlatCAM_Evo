msgstr "Nincs vezetősáv ezen a ponton."

#: appEditors/grb_plugins/GrbSelectionPlugin.py:131
msgid ""
"Incompatible aperture type. Select an aperture with type 'C', 'R' or 'O'."
msgstr ""
"Nem kompatibilis apertúratípus. 'C', 'R' vagy 'O' típusú apertúra "
