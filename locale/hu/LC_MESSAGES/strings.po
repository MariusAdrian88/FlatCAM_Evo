msgstr "A levágási téglalapnak rendelkeznie kell szélességgel és magassággal."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:208
msgid "Clip and replace with pad"
msgstr "Levágás és csere paddal"

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:253 appGUI/MainGUI.py:998
msgid "Stretch"
msgstr "Nyújtás"

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:260
msgid "Choose a finite, nonzero stretch distance."
msgstr "Véges, nem nulla nyújtási távolság megadása szükséges."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:276
msgid "The stretch would collapse a track."
msgstr "A nyújtás nullára zsugorítana egy vezetősávot."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:283
msgid "Nothing to stretch inside the rectangle."
msgstr "Nincs nyújtható elem a téglalapon belül."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:316
msgid "Insert elbow"
msgstr "Töréspont beszúrása"

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:322
msgid "The tolerance must be finite and nonnegative."
msgstr "A tűrésnek végesnek és nem negatívnak kell lennie."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:326
msgid "No track near the clicked point."
msgstr "Nincs vezetősáv a kattintott pont közelében."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:333
msgid "The elbow doesn't change the track."
msgstr "A töréspont nem módosítja a vezetősávot."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:415
msgid "Drag a rectangle."
msgstr "Téglalap húzása."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:434
msgid "Drag a rectangle to clip the tracks and the regions."
msgstr "Téglalap húzása a vezetősávok és régiók levágásához."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:442
msgid "Drag a rectangle to clip and replace its content with a pad."
msgstr ""
"Téglalap húzása a tartalom levágásához és paddal való helyettesítéséhez."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:452
#: appEditors/grb_plugins/GrbTrackEditPlugin.py:505
msgid "Click a track end or drag a rectangle to stretch."
msgstr "Kattintás egy vezetősáv végére vagy téglalap húzása a nyújtáshoz."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:485
msgid "Click the reference point."
msgstr "Kattintás a referenciapontra."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:489
msgid "No track end near the click."
msgstr "Nincs vezetősávvég a kattintás közelében."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:495
#: appEditors/grb_plugins/GrbTrackEditPlugin.py:499
msgid "Click the new position."
msgstr "Kattintás az új pozícióra."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:528
#: appEditors/grb_plugins/GrbTrackEditPlugin.py:543
msgid "Click the track, then the elbow vertex."
msgstr "Kattintás a vezetősávra, majd a töréspont csúcspontjára."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:535
msgid "No track near the click."
msgstr "Nincs vezetősáv a kattintás közelében."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:538
msgid "Click the elbow vertex."
msgstr "Kattintás a töréspontra."

#: appEditors/grb_plugins/GrbTrackEditPlugin.py:559
msgid "Click the track, then the 90 degree elbow vertex."
msgstr "Kattintás a vezetősávra, majd a 90 fokos töréspontra."

#: appEditors/grb_plugins/GrbTrackPlugin.py:206
msgid "Snap to pad"
msgstr "Tapadás a padhoz"

#: appEditors/grb_plugins/GrbTrackPlugin.py:208
msgid ""
"Snap to the center of the pad under the mouse, even when its center is "
"off-grid."
msgstr ""
"Tapadás az egérmutató alatti pad középpontjához akkor is, ha a középpont "
"nem esik rácsra."

#: appEditors/grb_plugins/GrbTransformationPlugin.py:51
#: appEditors/grb_plugins/GrbTransformationPlugin.py:54
